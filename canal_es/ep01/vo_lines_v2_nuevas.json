[
 {
  "id": "s00_01",
  "who": "narrador",
  "text": "Esta maceta está a medio metro de la cabeza de Valeria."
 },
 {
  "id": "s00_02",
  "who": "narrador",
  "text": "El mundo entero está congelado."
 },
 {
  "id": "s00_03",
  "who": "narrador",
  "text": "Y tú eres el único que se mueve."
 },
 {
  "id": "s00_04",
  "who": "narrador",
  "text": "¿Cómo llegaste hasta aquí?"
 },
 {
  "id": "s00_05",
  "who": "narrador",
  "text": "Empecemos por el principio."
 },
 {
  "id": "s07_04",
  "who": "narrador",
  "text": "Nacho se despierta y se ve en el reflejo de la ventana."
 },
 {
  "id": "s08_03",
  "who": "narrador",
  "text": "Millones de gotas se quedan colgadas en el aire."
 },
 {
  "id": "s15_06",
  "who": "narrador",
  "text": "Y ahora tienes un problema: si aplaudes, Valeria te verá a su lado. Con una maceta. Salido de la nada."
 },
 {
  "id": "s04_08b",
  "who": "mama",
  "text": "¿Eh? ¿Y la taza?"
 },
 {
  "id": "s06_06b",
  "who": "profe",
  "text": "¿Ya terminaste? ¿Tú?"
 },
 {
  "id": "s07_04b",
  "who": "nacho",
  "text": "Mmm… me queda bien."
 },
 {
  "id": "s09_05b",
  "who": "valeria",
  "text": "¿Qué… acaba de pasar?"
 },
 {
  "id": "s10_06b",
  "who": "chicos",
  "text": "¡Gooool!"
 },
 {
  "id": "s10_07b",
  "who": "nacho",
  "text": "¿Pero… cómo?"
 },
 {
  "id": "s12_04b",
  "who": "tu",
  "text": "Ay, no…"
 },
 {
  "id": "s13_01b",
  "who": "chicos",
  "text": "¡Feliz cumpleaños, Nacho!"
 },
 {
  "id": "s13_02b",
  "who": "nacho",
  "text": "¡Gracias, gracias!"
 },
 {
  "id": "s14_05b",
  "who": "tu",
  "text": "Y entonces Valeria… bueno, tú me entiendes, Pepe."
 },
 {
  "id": "s17_00",
  "who": "narrador",
  "text": "Aquella maceta, a medio metro de su cabeza… y tú creías que eras el único que se movía."
 }
]