# Reddit: https://www.reddit.com/prefs/apps -> create app -> type "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# YouTube Data API v3 key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
# Imgur: https://api.imgur.com/oauth2/addclient -> "Anonymous usage without user authorization"
IMGUR_CLIENT_ID=
# Twitch: https://dev.twitch.tv/console/apps -> Register Your Application
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Необязательно: cookies.txt из браузера, если yt-dlp пишет "Sign in to confirm you're not a bot"
YTDLP_COOKIES=
