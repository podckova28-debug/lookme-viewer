# Reddit: https://www.reddit.com/prefs/apps -> create app -> type "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# YouTube Data API v3 key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
# Необязательно: cookies.txt из браузера, если yt-dlp пишет "Sign in to confirm you're not a bot"
YTDLP_COOKIES=
