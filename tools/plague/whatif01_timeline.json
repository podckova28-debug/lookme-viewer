   "y": 985,
   "size": 50,
   "t0": 145.348,
   "t1": 148.628
  },
  {
   "text": "A cesspit beside the pump",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 149.078,
   "t1": 151.947
  },
  {
   "text": "Broad Street, September 1854",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 152.397,
   "t1": 155.265
  },
  {
   "text": "500 dead in 10 days",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 155.715,
   "t1": 158.584
  },
  {
   "text": "You survive",
