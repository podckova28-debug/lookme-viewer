   "y": 985,
   "size": 50,
   "t0": 45.468,
   "t1": 49.157
  },
  {
   "text": "HOUR 12",
   "x": 1640,
   "y": 110,
   "size": 72,
   "style": "title",
   "pop": true,
   "t0": 45.268,
   "t1": 49.157
  },
  {
   "text": "Billions, overnight",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 49.607,
   "t1": 53.297
  },
  {
   "text": "HOUR 20",
