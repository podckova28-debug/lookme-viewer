   "y": 985,
   "size": 50,
   "t0": 167.252,
   "t1": 170.918
  },
  {
   "text": "John Snow, 8 September 1854",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 171.368,
   "t1": 175.034
  },
  {
   "text": "The brewery workers drank beer",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 175.484,
   "t1": 180.256
  },
  {
   "text": "Same cup, today",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 183.281,
   "t1": 185.83
  },
  {
   "text": "2026",
   "x": 1640,
   "y": 110,
   "size": 72,
   "style": "title",
   "pop": true,
   "t0": 183.081,
   "t1": 185.83
  },
  {
   "text": "Water, salt, sugar",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 186.28,
   "t1": 188.977
  },
  {
   "text": "Oral rehydration",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 192.574,
   "t1": 195.271
  },
  {
   "text": "From 1 in 2 to under 1 in 100",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 195.721,
   "t1": 203.764
  },
  {
   "text": "Back on your feet",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 204.214,
   "t1": 207.56
  },
  {
   "text": "DAY 3",
