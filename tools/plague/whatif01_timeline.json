   "size": 72,
   "style": "title",
   "pop": true,
   "t0": 128.707,
   "t1": 131.529
  },
  {
   "text": "A pulse you can barely feel",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 131.979,
   "t1": 134.601
  },
  {
   "text": "Severe and untreated: about half die",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 135.051,
   "t1": 141.167
  },
  {
   "text": "The next person drinks you",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 141.617,
   "t1": 144.898
  },
  {
   "text": "Into the cesspit",
