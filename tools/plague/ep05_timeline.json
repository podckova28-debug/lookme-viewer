 ],
 "texts": [
  {
   "text": "Rounding Cape Horn, 1741",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 9.831,
   "t1": 14.146
  },
  {
   "text": "Portsmouth, September 1740",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 14.596,
   "t1": 18.571
  },
  {
   "text": "Commodore George Anson",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 19.021,
   "t1": 22.995
  },
  {
   "text": "Six ships and nearly 2,000 men",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 23.445,
   "t1": 27.42
  },
  {
   "text": "Home again, summer 1744",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 27.87,
   "t1": 32.345
  },
  {
   "text": "Four killed in battle, over a thousand by disease",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 32.795,
   "t1": 37.27
  },
  {
   "text": "SCURVY",
   "x": 1300,
   "y": 330,
   "size": 140,
   "style": "title",
   "pop": true,
   "t0": 42.047,
   "t1": 46.247
  },
  {
   "text": "THE SAILORS' PLAGUE",
   "x": 1300,
   "y": 470,
   "size": 72,
   "style": "title",
   "color": [
    230,
    200,
    110
   ],
   "t0": 42.397,
   "t1": 46.297
  },
  {
   "text": "Not a germ, but a missing vitamin",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 46.797,
   "t1": 50.958
  },
  {
   "text": "Collagen, the body's glue",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 60.215,
   "t1": 63.96
  },
  {
   "text": "With vitamin C, and without it",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 68.605,
   "t1": 75.925
  },
  {
   "text": "They make their own vitamin C",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 82.176,
   "t1": 86.772
  },
  {
   "text": "About 60 million years ago",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 92.267,
   "t1": 97.174
  },
  {
   "text": "One broken gene",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 97.624,
   "t1": 102.531
  },
  {
   "text": "Passed down all the way to us",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 102.981,
   "t1": 106.459
  },
  {
   "text": "Guinea pigs lost it too",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 106.909,
   "t1": 110.388
  },
  {
   "text": "One to three months without fresh food",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 122.898,
   "t1": 126.388
  },
  {
   "text": "What he does to you",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 130.778,
   "t1": 135.196
  },
  {
   "text": "First, you just feel tired",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 130.778,
   "t1": 135.196
  },
  {
   "text": "Often mistaken for laziness",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 135.646,
   "t1": 140.064
  },
  {
   "text": "Even the hairs grow like corkscrews",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 140.514,
   "t1": 145.771
  },
  {
   "text": "Swollen gums, loose teeth",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 151.928,
   "t1": 157.291
  },
  {
   "text": "Old wounds open up again",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 167.566,
   "t1": 171.126
  },
  {
   "text": "An enemy since ancient times",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 190.877,
   "t1": 194.9
  },
  {
   "text": "Crusaders, the 1200s",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 195.35,
   "t1": 199.372
  },
  {
   "text": "Salt beef, dry biscuit and beer",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 208.319,
   "t1": 213.185
  },
  {
   "text": "Some two million sailors, 1500 to 1800",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 218.952,
   "t1": 223.743
  },
  {
   "text": "Vasco da Gama, 1497",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 236.809,
   "t1": 241.435
  },
  {
   "text": "East Africa, 1498",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 246.962,
   "t1": 251.588
  },
  {
   "text": "More than half the crew died",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 252.038,
   "t1": 258.654
  },
  {
   "text": "Jacques Cartier's ships, Canada, winter 1536",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 259.104,
   "t1": 263.122
  },
  {
   "text": "Domagaya shows them the cure",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 263.572,
   "t1": 267.591
  },
  {
   "text": "A tea of cedar needles and bark",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 272.509,
   "t1": 276.528
  },
  {
   "text": "Captain James Lancaster, 1601",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 285.379,
   "t1": 289.693
  },
  {
   "text": "Three spoonfuls of lemon juice every morning",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 290.143,
   "t1": 294.457
  },
  {
   "text": "HMS Salisbury, 1747",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 303.682,
   "t1": 307.628
  },
  {
   "text": "James Lind, naval surgeon",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 308.078,
   "t1": 312.025
  },
  {
   "text": "Twelve sailors, split into six pairs",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 312.475,
   "t1": 316.421
  },
  {
   "text": "Six pairs, six different cures",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 316.871,
   "t1": 321.782
  },
  {
   "text": "Day six: the citrus pair is back on duty",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 327.594,
   "t1": 332.582
  },
  {
   "text": "One of the first controlled trials in medicine",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 333.032,
   "t1": 338.02
  },
  {
   "text": "Boiling destroys most of the vitamin C",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 338.47,
   "t1": 343.999
  },
  {
   "text": "Almost fifty years of waiting",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 344.449,
   "t1": 349.979
  },
  {
   "text": "Captain James Cook, 1768",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 356.538,
   "t1": 361.911
  },
  {
   "text": "Sauerkraut, and fresh food at every stop",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 362.361,
   "t1": 367.733
  },
  {
   "text": "The sauerkraut trick",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 368.183,
   "t1": 372.487
  },
  {
   "text": "Lemon juice for every sailor from 1795",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 394.165,
   "t1": 398.106
  },
  {
   "text": "Months at sea off the coast of France",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 398.556,
   "t1": 403.398
  },
  {
   "text": "The Napoleonic Wars",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 403.848,
   "t1": 408.689
  },
  {
   "text": "Cheaper limes from the colonies",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 409.139,
   "t1": 412.718
  },
  {
   "text": "Limes have far less vitamin C",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 413.168,
   "t1": 416.746
  },
  {
   "text": "The Limeys",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 417.196,
   "t1": 420.774
  },
  {
   "text": "The Arctic, 1875",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 426.233,
   "t1": 430.09
  },
  {
   "text": "Bad tinned meat? A germ?",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 439.154,
   "t1": 443.164
  },
  {
   "text": "Antarctica, 1902",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 443.614,
   "t1": 447.625
  },
  {
   "text": "Robert Falcon Scott's first expedition",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 448.075,
   "t1": 452.086
  },
  {
   "text": "Potatoes, the poor's vitamin C",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 452.536,
   "t1": 457.211
  },
  {
   "text": "A gold-rush camp, the 1850s",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 462.786,
   "t1": 467.461
  },
  {
   "text": "Kristiania (Oslo), 1907",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 471.456,
   "t1": 475.499
  },
  {
   "text": "Axel Holst and Theodor Fr\u00f8lich",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 475.949,
   "t1": 479.993
  },
  {
   "text": "Testing food by food",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 484.936,
   "t1": 488.472
  },
  {
   "text": "Casimir Funk, 1912",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 496.896,
   "t1": 501.678
  },
  {
   "text": "Szeged, Hungary",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 507.36,
   "t1": 511.609
  },
  {
   "text": "Ascorbic acid: literally, no scurvy",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 512.059,
   "t1": 516.308
  },
  {
   "text": "Albert Szent-Gy\u00f6rgyi",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 516.758,
   "t1": 521.006
  },
  {
   "text": "Nobel Prize, 1937",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 521.456,
   "t1": 525.705
  },
  {
   "text": "What he leaves behind",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 537.867,
   "t1": 542.272
  },
  {
   "text": "Cured in days, but lost teeth stay lost",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 537.867,
   "t1": 542.272
  },
  {
   "text": "The idea of vitamins",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 552.486,
   "t1": 556.945
  },
  {
   "text": "Doctors still see him today",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 569.376,
   "t1": 574.017
  },
  {
   "text": "One orange a day is enough",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 584.65,
   "t1": 587.37
  },
  {
