 "texts": [
  {
   "text": "Havana, August 1900",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 0.3,
   "t1": 6.929
  },
  {
   "text": "On purpose",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 7.379,
   "t1": 14.007
  },
  {
   "text": "Fever, and the eyes turn yellow",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 14.457,
   "t1": 19.18
  },
  {
   "text": "Jesse Lazear",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 19.63,
   "t1": 24.352
  },
  {
   "text": "Three centuries of terror",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 24.802,
   "t1": 34.301
  },
  {
   "text": "YELLOW FEVER",
   "x": 1300,
   "y": 330,
   "size": 130,
   "style": "title",
   "pop": true,
   "t0": 38.162,
   "t1": 42.362
  },
  {
   "text": "YELLOW JACK",
   "x": 1300,
   "y": 470,
   "size": 72,
   "style": "title",
   "color": [
    235,
    200,
    80
   ],
   "t0": 38.512,
   "t1": 42.412
  },
  {
   "text": "Aedes aegypti",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 50.445,
   "t1": 57.529
  },
  {
   "text": "One bite is enough",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 57.979,
   "t1": 62.304
  },
  {
   "text": "She bites by day",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 62.754,
   "t1": 67.08
  },
  {
   "text": "Barrels, buckets, flower pots",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 67.53,
   "t1": 71.671
  },
  {
   "text": "A mosquito nursery",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 72.121,
   "t1": 76.262
  },
  {
   "text": "Monkeys, mosquitoes, people",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 81.138,
   "t1": 84.112
  },
  {
   "text": "The forests of Africa",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 84.562,
   "t1": 87.535
  },
  {
   "text": "A forest mosquito",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 87.985,
   "t1": 90.959
  },
  {
   "text": "Barbados and Yucat\u00e1n, 1640s",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 98.86,
   "t1": 105.861
  },
  {
   "text": "Yellow Jack",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 106.311,
   "t1": 116.761
  },
  {
   "text": "What He Does to You",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 121.709,
   "t1": 125.417
  },
  {
   "text": "Fever, headache, backache",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 121.709,
   "t1": 125.417
  },
  {
   "text": "Three to six days after the bite",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 125.867,
   "t1": 129.574
  },
  {
   "text": "Chills in the heat",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 130.024,
   "t1": 133.732
  },
  {
   "text": "The second wave",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 134.182,
   "t1": 141.037
  },
  {
   "text": "The liver fails, the skin turns yellow",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 141.487,
   "t1": 147.702
  },
  {
   "text": "Half of them die",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 148.152,
   "t1": 154.368
  },
  {
   "text": "Immune for life",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 154.818,
   "t1": 162.202
  },
  {
   "text": "Philadelphia, 1793",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 168.422,
   "t1": 172.581
  },
  {
   "text": "About 1 in 10 died",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 173.031,
   "t1": 177.19
  },
  {
   "text": "It came by ship",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 177.64,
   "t1": 181.799
  },
  {
   "text": "20,000 fled",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 182.249,
   "t1": 186.751
  },
  {
   "text": "Dr Benjamin Rush",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 187.201,
   "t1": 191.703
  },
  {
   "text": "Richard Allen and Absalom Jones",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 192.153,
   "t1": 207.276
  },
  {
   "text": "Saint-Domingue, 1802",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 214.393,
   "t1": 225.03
  },
  {
   "text": "Waiting for the rains",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 225.48,
   "t1": 230.461
  },
  {
   "text": "The fever tore through the French",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 230.911,
   "t1": 235.892
  },
  {
   "text": "General Leclerc died in 1802",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 236.342,
   "t1": 241.323
  },
  {
   "text": "Haiti, 1804: independence",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 241.773,
   "t1": 248.324
  },
  {
   "text": "1803: the Louisiana Purchase",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 248.774,
   "t1": 255.325
  },
  {
   "text": "Memphis, 1878",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 260.52,
   "t1": 264.914
  },
  {
   "text": "Up the Mississippi",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 265.364,
   "t1": 269.758
  },
  {
   "text": "A city emptied",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 270.208,
   "t1": 274.602
  },
  {
   "text": "Bad air? Dirty sheets?",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 275.052,
   "t1": 280.975
  },
  {
   "text": "Burning tar to clean the air",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 281.425,
   "t1": 287.348
  },
  {
   "text": "Carlos Finlay, 1881",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 287.798,
   "t1": 296.067
  },
  {
   "text": "The dirty-sheets hut",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 296.517,
   "t1": 302.866
  },
  {
   "text": "Walter Reed",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 303.316,
   "t1": 309.665
  },
  {
   "text": "The mosquito was the answer",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 310.115,
   "t1": 317.479
  },
  {
   "text": "Clara Maass, 1901",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 317.929,
   "t1": 325.293
  },
  {
   "text": "William Gorgas, Havana",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 329.599,
   "t1": 332.975
  },
  {
   "text": "Lids, oil and screens",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 333.425,
   "t1": 336.801
  },
  {
   "text": "Lids on every barrel",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 337.251,
   "t1": 340.627
  },
  {
   "text": "Panama, 1880s",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 341.077,
   "t1": 348.574
  },
  {
   "text": "1914: the canal opens",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 349.024,
   "t1": 356.52
  },
  {
   "text": "Max Theiler, 1937",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 362.384,
   "t1": 367.135
  },
  {
   "text": "One shot, protected for life",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 367.585,
   "t1": 372.337
  },
  {
   "text": "The yellow card",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 372.787,
   "t1": 379.912
  },
  {
   "text": "What He Leaves Behind",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 380.362,
   "t1": 387.724
  },
  {
   "text": "Exhaustion, then immunity",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 380.362,
   "t1": 387.724
  },
  {
   "text": "He redrew the map",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 388.174,
   "t1": 393.167
  },
  {
   "text": "Stop the insect, stop the disease",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 393.617,
   "t1": 398.611
  },
  {
   "text": "Still here",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 404.569,
   "t1": 411.62
  },
  {
   "text": "One shot would protect them",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 412.07,
   "t1": 419.122
  },
  {
   "text": "Dengue, Zika, yellow fever",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 419.572,
   "t1": 430.341
  },
  {
   "text": "NEXT TIME",
   "x": 1380,
   "y": 360,
   "size": 110,
   "style": "title",
   "pop": true,
   "t0": 461.615,
   "t1": 466.215
  },
  {
   "text": "SUBSCRIBE",
   "x": 1380,
   "y": 500,
   "size": 64,
   "t0": 462.215,
   "t1": 466.215
  }
 ],
