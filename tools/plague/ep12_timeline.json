 "texts": [
  {
   "text": "Havana, August 1900",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 0.3,
   "t1": 6.161
  },
  {
   "text": "On purpose",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 6.611,
   "t1": 12.473
  },
  {
   "text": "Fever, and the eyes turn yellow",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 12.923,
   "t1": 17.052
  },
  {
   "text": "Jesse Lazear",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 17.502,
   "t1": 21.632
  },
  {
   "text": "Three centuries of terror",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 22.082,
   "t1": 30.419
  },
  {
   "text": "YELLOW FEVER",
   "x": 1300,
   "y": 330,
   "size": 130,
   "style": "title",
   "pop": true,
   "t0": 33.693,
   "t1": 37.893
  },
  {
   "text": "YELLOW JACK",
   "x": 1300,
   "y": 470,
   "size": 72,
   "style": "title",
   "color": [
    235,
    200,
    80
   ],
   "t0": 34.043,
   "t1": 37.943
  },
  {
   "text": "Aedes aegypti",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 45.164,
   "t1": 51.436
  },
  {
   "text": "One bite is enough",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 51.886,
   "t1": 55.648
  },
  {
   "text": "She bites by day",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 56.098,
   "t1": 59.86
  },
  {
   "text": "Barrels, buckets, flower pots",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 60.31,
   "t1": 63.908
  },
  {
   "text": "A mosquito nursery",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 64.358,
   "t1": 67.957
  },
  {
   "text": "Monkeys, mosquitoes, people",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 72.172,
   "t1": 74.751
  },
  {
   "text": "The forests of Africa",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 75.201,
   "t1": 77.779
  },
  {
   "text": "A forest mosquito",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 78.229,
   "t1": 80.808
  },
  {
   "text": "Barbados and Yucat\u00e1n, 1640s",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 87.905,
   "t1": 94.101
  },
  {
   "text": "Yellow Jack",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 94.551,
   "t1": 103.771
  },
  {
   "text": "What He Does to You",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 108.054,
   "t1": 111.297
  },
  {
   "text": "Fever, headache, backache",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 108.054,
   "t1": 111.297
  },
  {
   "text": "Three to six days after the bite",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 111.747,
   "t1": 114.99
  },
  {
   "text": "Chills in the heat",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 115.44,
   "t1": 118.683
  },
  {
   "text": "The second wave",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 119.133,
   "t1": 125.077
  },
  {
   "text": "The liver fails, the skin turns yellow",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 125.527,
   "t1": 131.013
  },
  {
   "text": "Half of them die",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 131.463,
   "t1": 136.949
  },
  {
   "text": "Immune for life",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 137.399,
   "t1": 143.823
  },
  {
   "text": "Philadelphia, 1793",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 149.263,
   "t1": 152.918
  },
  {
   "text": "About 1 in 10 died",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 153.368,
   "t1": 157.024
  },
  {
   "text": "It came by ship",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 157.474,
   "t1": 161.13
  },
  {
   "text": "20,000 fled",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 161.58,
   "t1": 165.508
  },
  {
   "text": "Dr Benjamin Rush",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 165.958,
   "t1": 169.885
  },
  {
   "text": "Richard Allen and Absalom Jones",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 170.335,
   "t1": 183.775
  },
  {
   "text": "Saint-Domingue, 1802",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 190.032,
   "t1": 199.41
  },
  {
   "text": "Waiting for the rains",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 199.86,
   "t1": 204.262
  },
  {
   "text": "The fever tore through the French",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 204.712,
   "t1": 209.114
  },
  {
   "text": "General Leclerc died in 1802",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 209.564,
   "t1": 213.965
  },
  {
   "text": "Haiti, 1804: independence",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 214.415,
   "t1": 220.205
  },
  {
   "text": "1803: the Louisiana Purchase",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 220.655,
   "t1": 226.444
  },
  {
   "text": "Memphis, 1878",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 230.951,
   "t1": 234.822
  },
  {
   "text": "Up the Mississippi",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 235.272,
   "t1": 239.142
  },
  {
   "text": "A city emptied",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 239.592,
   "t1": 243.462
  },
  {
   "text": "Bad air? Dirty sheets?",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 243.912,
   "t1": 249.129
  },
  {
   "text": "Burning tar to clean the air",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 249.579,
   "t1": 254.796
  },
  {
   "text": "Carlos Finlay, 1881",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 255.246,
   "t1": 262.466
  },
  {
   "text": "The dirty-sheets hut",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 262.916,
   "t1": 268.527
  },
  {
   "text": "Walter Reed",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 268.977,
   "t1": 274.588
  },
  {
   "text": "The mosquito was the answer",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 275.038,
   "t1": 281.564
  },
  {
   "text": "Clara Maass, 1901",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 282.014,
   "t1": 288.539
  },
  {
   "text": "William Gorgas, Havana",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 292.241,
   "t1": 295.184
  },
  {
   "text": "Lids, oil and screens",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 295.634,
   "t1": 298.578
  },
  {
   "text": "Lids on every barrel",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 299.028,
   "t1": 301.971
  },
  {
   "text": "Panama, 1880s",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 302.421,
   "t1": 309.073
  },
  {
   "text": "1914: the canal opens",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 309.523,
   "t1": 316.175
  },
  {
   "text": "Max Theiler, 1937",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 321.31,
   "t1": 325.459
  },
  {
   "text": "One shot, protected for life",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 325.909,
   "t1": 330.058
  },
  {
   "text": "The yellow card",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 330.508,
   "t1": 336.706
  },
  {
   "text": "What He Leaves Behind",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 337.156,
   "t1": 343.558
  },
  {
   "text": "Exhaustion, then immunity",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 337.156,
   "t1": 343.558
  },
  {
   "text": "He redrew the map",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 344.008,
   "t1": 348.379
  },
  {
   "text": "Stop the insect, stop the disease",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 348.829,
   "t1": 353.2
  },
  {
   "text": "Still here",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 358.407,
   "t1": 364.649
  },
  {
   "text": "One shot would protect them",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 365.099,
   "t1": 371.34
  },
  {
   "text": "Dengue, Zika, yellow fever",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 371.79,
   "t1": 381.289
  },
  {
   "text": "NEXT TIME",
   "x": 1380,
   "y": 360,
   "size": 110,
   "style": "title",
   "pop": true,
   "t0": 408.998,
   "t1": 413.598
  },
  {
   "text": "SUBSCRIBE",
   "x": 1380,
   "y": 500,
   "size": 64,
   "t0": 409.598,
   "t1": 413.598
  }
 ],
