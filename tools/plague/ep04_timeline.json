 ],
 "texts": [
  {
   "text": "Albert Gitchell, army cook",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 3.967,
   "t1": 7.184
  },
  {
   "text": "Camp Funston, Kansas \u2014 March 1918",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 11.301,
   "t1": 14.518
  },
  {
   "text": "Over 100 sick by lunchtime",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 14.968,
   "t1": 16.927
  },
  {
   "text": "Over 1,000 within weeks",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 19.786,
   "t1": 21.745
  },
  {
   "text": "One in three people infected",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 22.195,
   "t1": 25.21
  },
  {
   "text": "Deadlier than the war itself",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 25.66,
   "t1": 28.676
  },
  {
   "text": "THE SPANISH FLU",
   "x": 1300,
   "y": 330,
   "size": 130,
   "style": "title",
   "pop": true,
   "t0": 35.309,
   "t1": 39.509
  },
  {
   "text": "1918 \u2013 1920",
   "x": 1300,
   "y": 470,
   "size": 80,
   "style": "title",
   "color": [
    160,
    170,
    220
   ],
   "t0": 35.659,
   "t1": 39.559
  },
  {
   "text": "Influenza A, type H1N1",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 42.585,
   "t1": 44.66
  },
  {
   "text": "H is the key, N is the scissors",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 50.162,
   "t1": 61.516
  },
  {
   "text": "Contagious a day before symptoms",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 65.441,
   "t1": 67.584
  },
  {
   "text": "What he does to you",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 73.221,
   "t1": 76.833
  },
  {
   "text": "Fever, headache, aching muscles",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 73.221,
   "t1": 76.833
  },
  {
   "text": "Most recover in about a week",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 77.283,
   "t1": 80.896
  },
  {
   "text": "Lungs filling with fluid",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 85.408,
   "t1": 89.586
  },
  {
   "text": "Heliotrope cyanosis",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 94.664,
   "t1": 98.29
  },
  {
   "text": "Dead within a day",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 102.815,
   "t1": 106.441
  },
  {
   "text": "Then came the bacteria",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 106.891,
   "t1": 118.382
  },
  {
   "text": "It also killed people aged 20 to 40",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 122.366,
   "t1": 125.821
  },
  {
   "text": "Healthy, strong, young adults",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 126.271,
   "t1": 129.725
  },
  {
   "text": "An immune system overreaction?",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 134.08,
   "t1": 147.865
  },
  {
   "text": "The Russian flu of 1889",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 148.315,
   "t1": 153.691
  },
  {
   "text": "By train and steamship",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 154.141,
   "t1": 159.516
  },
  {
   "text": "It starts in wild water birds",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 163.072,
   "t1": 166.754
  },
  {
   "text": "From birds to pigs to people",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 167.204,
   "t1": 170.887
  },
  {
   "text": "Where did he start? Nobody knows",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 175.469,
   "t1": 179.848
  },
  {
   "text": "A British army camp in France",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 180.298,
   "t1": 184.676
  },
  {
   "text": "Northern China, 1917",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 185.126,
   "t1": 189.505
  },
  {
   "text": "Brevig Mission, Alaska \u2014 1997",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 193.088,
   "t1": 196.83
  },
  {
   "text": "Johan Hultin",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 197.28,
   "t1": 201.021
  },
  {
   "text": "Frozen for almost 80 years",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 201.471,
   "t1": 205.212
  },
  {
   "text": "72 of about 80 adults, dead in five days",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 209.853,
   "t1": 217.451
  },
  {
   "text": "2005: the 1918 virus, rebuilt",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 217.901,
   "t1": 229.61
  },
  {
   "text": "Locked away in a top-security lab",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 230.06,
   "t1": 236.478
  },
  {
   "text": "Far deadlier than ordinary flu",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 236.928,
   "t1": 243.346
  },
  {
   "text": "Wartime censorship",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 247.58,
   "t1": 250.321
  },
  {
   "text": "Madrid, May 1918",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 250.771,
   "t1": 253.512
  },
  {
   "text": "Even the King of Spain",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 253.962,
   "t1": 256.703
  },
  {
   "text": "Only Spain reported it freely",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 263.535,
   "t1": 271.041
  },
  {
   "text": "Three waves, from 1918 to 1919",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 275.652,
   "t1": 279.608
  },
  {
   "text": "Autumn 1918: the deadly wave",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 280.058,
   "t1": 284.013
  },
  {
   "text": "Troopships across the Atlantic",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 288.869,
   "t1": 292.124
  },
  {
   "text": "By ship and by train",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 292.574,
   "t1": 295.828
  },
  {
   "text": "Officially, just ordinary influenza",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 307.478,
   "t1": 313.189
  },
  {
   "text": "Meanwhile, the hospitals filled up",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 313.639,
   "t1": 319.35
  },
  {
   "text": "Philadelphia \u2014 28 September 1918",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 323.955,
   "t1": 331.058
  },
  {
   "text": "About 200,000 people",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 331.508,
   "t1": 338.612
  },
  {
   "text": "Within three days, every bed full",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 339.062,
   "t1": 343.362
  },
  {
   "text": "Over 12,000 dead in six weeks",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 343.812,
   "t1": 348.112
  },
  {
   "text": "Volunteers stepped in",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 352.399,
   "t1": 355.786
  },
  {
   "text": "Not enough doctors, not even coffins",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 356.236,
   "t1": 359.623
  },
  {
   "text": "St. Louis, October 1918",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 360.073,
   "t1": 363.024
  },
  {
   "text": "Half the death rate of Philadelphia",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 363.474,
   "t1": 366.425
  },
  {
   "text": "San Francisco: masks by law",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 373.515,
   "t1": 378.736
  },
  {
   "text": "Refuse a mask, pay a fine",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 379.186,
   "t1": 384.408
  },
  {
   "text": "Red Cross volunteers",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 384.858,
   "t1": 388.26
  },
  {
   "text": "Layers of cotton gauze",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 388.71,
   "t1": 392.112
  },
  {
   "text": "Folk remedies of 1918",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 392.562,
   "t1": 399.111
  },
  {
   "text": "The aspirin problem",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 399.561,
   "t1": 406.109
  },
  {
   "text": "Western Samoa: one in five died",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 410.155,
   "t1": 415.089
  },
  {
   "text": "American Samoa: not one flu death",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 415.539,
   "t1": 420.474
  },
  {
   "text": "Bombay, 1918",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 429.816,
   "t1": 433.914
  },
  {
   "text": "India: 12 million or more dead",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 434.364,
   "t1": 438.462
  },
  {
   "text": "Mohandas Gandhi, aged 49",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 438.912,
   "t1": 443.01
  },
  {
   "text": "Woodrow Wilson, Paris 1919",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 443.46,
   "t1": 446.693
  },
  {
   "text": "Walt Disney, aged 16",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 447.143,
   "t1": 450.376
  },
  {
   "text": "Edvard Munch",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 450.826,
   "t1": 454.059
  },
  {
   "text": "By 1920, he ran out of victims",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 458.192,
   "t1": 463.423
  },
  {
   "text": "1920: life goes on",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 463.873,
   "t1": 469.104
  },
  {
   "text": "What he leaves behind",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 469.554,
   "t1": 475.995
  },
  {
   "text": "Even the unborn were affected",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 469.554,
   "t1": 475.995
  },
  {
   "text": "Weak for weeks",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 476.445,
   "t1": 482.885
  },
  {
   "text": "The first health ministries",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 483.335,
   "t1": 488.006
  },
  {
   "text": "Ministry of Health, London 1919",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 488.456,
   "t1": 493.127
  },
  {
   "text": "From 1918 to the 2009 swine flu",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 497.392,
   "t1": 501.829
  },
  {
   "text": "A new flu vaccine every season",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 507.166,
   "t1": 511.767
  },
  {
   "text": "Around 50 million lives",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 520.255,
   "t1": 522.095
  },
