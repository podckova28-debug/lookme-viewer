 ],
 "texts": [
  {
   "text": "It's 35 degrees, and he's freezing",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 0.3,
   "t1": 4.957
  },
  {
   "text": "Then the fever",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 5.407,
   "t1": 10.064
  },
  {
   "text": "And in two days, again",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 10.514,
   "t1": 15.171
  },
  {
   "text": "Ronald Ross",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 15.621,
   "t1": 20.017
  },
  {
   "text": "Two years of mosquitoes",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 20.467,
   "t1": 24.862
  },
  {
   "text": "Secunderabad, India \u2014 August 1897",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 25.312,
   "t1": 29.708
  },
  {
   "text": "Inside a mosquito's stomach",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 30.158,
   "t1": 35.295
  },
  {
   "text": "20 August 1897",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 35.745,
   "t1": 40.882
  },
  {
   "text": "MALARIA",
   "x": 1300,
   "y": 330,
   "size": 130,
   "style": "title",
   "pop": true,
   "t0": 45.321,
   "t1": 49.521
  },
  {
   "text": "THE MARSH FEVER",
   "x": 1300,
   "y": 470,
   "size": 72,
   "style": "title",
   "color": [
    214,
    200,
    120
   ],
   "t0": 45.671,
   "t1": 49.571
  },
  {
   "text": "Plasmodium, a single-celled parasite",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 55.955,
   "t1": 61.389
  },
  {
   "text": "Only the females bite",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 61.839,
   "t1": 65.503
  },
  {
   "text": "She bites at dusk and at night",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 65.953,
   "t1": 69.617
  },
  {
   "text": "First, he hides in the liver",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 70.067,
   "t1": 73.793
  },
  {
   "text": "A week or two of silence",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 74.243,
   "t1": 77.968
  },
  {
   "text": "Into the blood cells, over and over",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 83.943,
   "t1": 90.523
  },
  {
   "text": "What a doctor sees under the microscope",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 90.973,
   "t1": 97.553
  },
  {
   "text": "Human, mosquito, human",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 98.003,
   "t1": 100.903
  },
  {
   "text": "Every bite passes him on",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 101.353,
   "t1": 104.252
  },
  {
   "text": "Most likely from gorillas",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 110.133,
   "t1": 114.584
  },
  {
   "text": "Africa, long before history",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 115.034,
   "t1": 119.485
  },
  {
   "text": "Traced back through gorilla parasites",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 119.935,
   "t1": 124.385
  },
  {
   "text": "Farms meant still water",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 124.835,
   "t1": 129.534
  },
  {
   "text": "Out of Africa",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 129.984,
   "t1": 134.684
  },
  {
   "text": "Even Tutankhamun had him",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 135.134,
   "t1": 141.018
  },
  {
   "text": "The sickle-cell gene: a shield",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 141.468,
   "t1": 147.164
  },
  {
   "text": "One copy protects",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 147.614,
   "t1": 153.309
  },
  {
   "text": "What He Does to You",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 157.465,
   "t1": 161.099
  },
  {
   "text": "First, the chills",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 157.465,
   "t1": 161.099
  },
  {
   "text": "Shaking in the heat",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 161.549,
   "t1": 165.184
  },
  {
   "text": "Cold, then hot, then soaked in sweat",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 165.634,
   "t1": 170.992
  },
  {
   "text": "Then the sweats",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 171.442,
   "t1": 176.8
  },
  {
   "text": "Every second or third day",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 177.25,
   "t1": 182.488
  },
  {
   "text": "Tertian and quartan fevers",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 182.938,
   "t1": 188.177
  },
  {
   "text": "Pale, weak, a swollen spleen",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 188.627,
   "t1": 194.271
  },
  {
   "text": "When he reaches the brain",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 194.721,
   "t1": 200.364
  },
  {
   "text": "Children suffer the most",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 200.814,
   "t1": 206.399
  },
  {
   "text": "Ancient China",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 212.835,
   "t1": 220.272
  },
  {
   "text": "Worse near the marshes",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 220.722,
   "t1": 228.159
  },
  {
   "text": "A temple to Febris, goddess of fever",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 228.609,
   "t1": 233.229
  },
  {
   "text": "The marshes around Rome",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 233.679,
   "t1": 238.299
  },
  {
   "text": "Mal'aria: bad air",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 238.749,
   "t1": 248.674
  },
  {
   "text": "Alexander the Great, perhaps",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 253.318,
   "t1": 257.099
  },
  {
   "text": "Dante, 1321",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 257.549,
   "t1": 261.329
  },
  {
   "text": "Armies melted away",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 261.779,
   "t1": 265.56
  },
  {
   "text": "Peru, 1600s",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 266.01,
   "t1": 269.535
  },
  {
   "text": "Bark, powder, wine",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 269.985,
   "t1": 273.51
  },
  {
   "text": "The cinchona tree",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 273.96,
   "t1": 277.486
  },
  {
   "text": "Oliver Cromwell, 1658",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 277.936,
   "t1": 289.631
  },
  {
   "text": "Quinine, 1820",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 290.081,
   "t1": 297.956
  },
  {
   "text": "The gin and tonic",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 298.406,
   "t1": 302.507
  },
  {
   "text": "Medicine you could drink",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 302.957,
   "t1": 307.059
  },
  {
   "text": "The white man's grave",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 316.029,
   "t1": 327.152
  },
  {
   "text": "Alphonse Laveran \u2014 Algeria, 1880",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 327.602,
   "t1": 331.744
  },
  {
   "text": "Creatures inside the blood",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 332.194,
   "t1": 336.336
  },
  {
   "text": "Hardly anyone believed him",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 336.786,
   "t1": 340.927
  },
  {
   "text": "Ross proved it in birds",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 341.377,
   "t1": 346.479
  },
  {
   "text": "Giovanni Battista Grassi, Rome",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 346.929,
   "t1": 352.031
  },
  {
   "text": "A bitter fight for the credit",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 352.481,
   "t1": 357.583
  },
  {
   "text": "Panama, 1880s",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 363.588,
   "t1": 366.501
  },
  {
   "text": "About 20,000 dead",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 366.951,
   "t1": 369.863
  },
  {
   "text": "Malaria and yellow fever",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 370.313,
   "t1": 373.226
  },
  {
   "text": "William Gorgas",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 373.676,
   "t1": 378.141
  },
  {
   "text": "Drain, oil, screen",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 378.591,
   "t1": 383.056
  },
  {
   "text": "Opened in 1914",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 383.506,
   "t1": 387.971
  },
  {
   "text": "Millions of homes sprayed",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 393.888,
   "t1": 397.904
  },
  {
   "text": "The plan: wipe him out",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 398.354,
   "t1": 402.37
  },
  {
   "text": "DDT, 1955",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 402.82,
   "t1": 406.835
  },
  {
   "text": "Sri Lanka, 1963: just 17 cases",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 407.285,
   "t1": 415.547
  },
  {
   "text": "Back to half a million cases",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 415.997,
   "t1": 423.07
  },
  {
   "text": "The spraying stopped",
   "x": 960,
   "y": 985,
   "size": 50,
