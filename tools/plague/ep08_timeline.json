   "t0": 471.396,
   "t1": 478.869
  },
  {
   "text": "What He Leaves Behind",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 482.879,
   "t1": 491.459
  },
  {
   "text": "He can wake up years later",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 482.879,
   "t1": 491.459
  },
  {
   "text": "Back again, years later",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 491.909,
   "t1": 500.49
  },
  {
   "text": "He left more than graves",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 500.94,
   "t1": 508.524
  },
  {
   "text": "Nets over our beds",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 508.974,
   "t1": 516.559
  },
  {
   "text": "About 600,000 deaths a year",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 523.002,
   "t1": 526.095
  },
  {
   "text": "Most are children under five",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 526.545,
   "t1": 529.638
  },
  {
   "text": "Bed nets have saved millions",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 533.631,
   "t1": 538.452
  },
  {
   "text": "The first malaria vaccine, 2021",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 538.902,
   "t1": 543.722
  },
  {
   "text": "A test in fifteen minutes",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 544.172,
   "t1": 548.992
  },
  {
   "text": "Mosquitoes that can't carry him",
