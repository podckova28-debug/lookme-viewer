 "texts": [
  {
   "text": "Summer, 1952",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 0.3,
   "t1": 2.87
  },
  {
   "text": "By morning, he can't move his legs",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 3.32,
   "t1": 5.891
  },
  {
   "text": "By evening, he can't breathe",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 6.341,
   "t1": 8.911
  },
  {
   "text": "Row after row of iron lungs",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 9.361,
   "t1": 15.593
  },
  {
   "text": "1952: nearly 58,000 cases",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 16.043,
   "t1": 22.274
  },
  {
   "text": "The pools closed",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 22.724,
   "t1": 27.497
  },
  {
   "text": "Children kept inside",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 27.947,
   "t1": 32.721
  },
  {
   "text": "POLIO",
   "x": 1300,
   "y": 330,
   "size": 140,
   "style": "title",
   "pop": true,
   "t0": 38.78,
   "t1": 42.98
  },
  {
   "text": "THE SUMMER PLAGUE",
   "x": 1300,
   "y": 470,
   "size": 72,
   "style": "title",
   "color": [
    120,
    200,
    210
   ],
   "t0": 39.13,
   "t1": 43.03
  },
  {
   "text": "Poliovirus",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 50.576,
   "t1": 57.171
  },
  {
   "text": "Water, hands, mouth",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 57.621,
   "t1": 60.324
  },
  {
   "text": "Most people never notice him",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 60.774,
   "t1": 63.476
  },
  {
   "text": "A summer swim",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 63.926,
   "t1": 66.628
  },
  {
   "text": "About 1 in 200 is paralysed",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 67.078,
   "t1": 72.746
  },
  {
   "text": "Into the spinal cord",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 73.196,
   "t1": 78.863
  },
  {
   "text": "The nerves die, the muscles go limp",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 86.225,
   "t1": 91.228
  },
  {
   "text": "The legs go limp",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 91.678,
   "t1": 96.68
  },
  {
   "text": "Egypt, about 1400 BC",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 97.13,
   "t1": 102.384
  },
  {
   "text": "A withered leg",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 102.834,
   "t1": 108.088
  },
  {
   "text": "Babies caught him early",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 108.538,
   "t1": 114.02
  },
  {
   "text": "Mild, and immune for life",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 114.47,
   "t1": 119.953
  },
  {
   "text": "A disease of cleanliness",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 120.403,
   "t1": 133.668
  },
  {
   "text": "What He Does to You",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 139.065,
   "t1": 142.614
  },
  {
   "text": "It starts like summer flu",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 139.065,
   "t1": 142.614
  },
  {
   "text": "A stiff neck",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 143.064,
   "t1": 146.613
  },
  {
   "text": "A leg won't hold him up",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 147.063,
   "t1": 152.035
  },
  {
   "text": "Often just one side",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 152.485,
   "t1": 157.457
  },
  {
   "text": "The breathing muscles stop",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 157.907,
   "t1": 160.997
  },
  {
   "text": "The only view: a mirror",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 161.447,
   "t1": 164.537
  },
  {
   "text": "Leg braces and crutches",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 164.987,
   "t1": 174.533
  },
  {
   "text": "Vermont, 1894",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 179.777,
   "t1": 190.473
  },
  {
   "text": "Karl Landsteiner, 1908",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 190.923,
   "t1": 201.279
  },
  {
   "text": "New York, 1916",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 201.729,
   "t1": 205.586
  },
  {
   "text": "More than 2,000 deaths in the city",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 206.036,
   "t1": 209.893
  },
  {
   "text": "Families fled the city",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 210.343,
   "t1": 214.199
  },
  {
   "text": "Franklin D. Roosevelt, 1921",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 220.688,
   "t1": 226.353
  },
  {
   "text": "His legs never worked again",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 226.803,
   "t1": 232.468
  },
  {
   "text": "The March of Dimes, 1938",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 232.918,
   "t1": 238.094
  },
  {
   "text": "Millions of dimes",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 238.544,
   "t1": 243.719
  },
  {
   "text": "Send a dime",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 244.169,
   "t1": 249.344
  },
  {
   "text": "The iron lung, 1928",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 255.682,
   "t1": 259.904
  },
  {
   "text": "It breathed for you",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 260.354,
   "t1": 264.576
  },
  {
   "text": "About the price of a house",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 265.026,
   "t1": 269.249
  },
  {
   "text": "Paul Alexander: 70 years in an iron lung",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 269.699,
   "t1": 285.206
  },
  {
   "text": "Sister Elizabeth Kenny",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 285.656,
   "t1": 298.189
  },
  {
   "text": "Jonas Salk",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 298.639,
   "t1": 304.107
  },
  {
   "text": "A vaccine from killed virus",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 304.557,
   "t1": 310.025
  },
  {
   "text": "1.8 million Polio Pioneers",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 310.475,
   "t1": 315.94
  },
  {
   "text": "Polio Pioneers",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 316.39,
   "t1": 321.856
  },
  {
   "text": "12 April 1955",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 322.306,
   "t1": 328.853
  },
  {
   "text": "\"Could you patent the sun?\"",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 329.303,
   "t1": 335.85
  },
  {
   "text": "The Cutter incident, 1955",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 341.708,
   "t1": 356.723
  },
  {
   "text": "A sugar cube, 1959",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 357.173,
   "t1": 361.893
  },
  {
   "text": "Injection or sugar cube",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 362.343,
   "t1": 367.064
  },
  {
   "text": "Sugar Cube Sundays",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 367.514,
   "t1": 372.235
  },
  {
   "text": "Door to door, village to village",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 372.685,
   "t1": 380.34
  },
  {
   "text": "1988: 350,000 cases a year",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 380.79,
   "t1": 388.445
  },
  {
   "text": "Down more than 99%",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 388.895,
   "t1": 395.944
  },
  {
   "text": "What He Leaves Behind",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 401.892,
   "t1": 412.364
  },
  {
   "text": "Post-polio syndrome",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 401.892,
   "t1": 412.364
  },
  {
   "text": "Copenhagen, 1952: the first intensive care",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 412.814,
   "t1": 421.423
  },
  {
   "text": "He left more than braces",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 421.873,
   "t1": 430.481
  },
  {
   "text": "Only two countries left",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 437.334,
   "t1": 442.119
  },
  {
   "text": "Two drops in the mouth",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 442.569,
   "t1": 447.354
  },
  {
   "text": "Found in the sewage",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 447.804,
   "t1": 452.59
  },
  {
   "text": "Closer than ever",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 453.04,
   "t1": 462.752
  },
  {
   "text": "NEXT TIME",
   "x": 1380,
   "y": 360,
   "size": 110,
   "style": "title",
   "pop": true,
   "t0": 489.719,
   "t1": 494.319
  },
  {
   "text": "SUBSCRIBE",
   "x": 1380,
   "y": 500,
   "size": 64,
   "t0": 490.319,
   "t1": 494.319
  }
 ],
