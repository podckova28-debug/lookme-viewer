   "text": "Two hours in the air",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 34.487,
   "t1": 38.598
  },
  {
   "text": "He lingers in the air",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 39.048,
   "t1": 43.16
  },
  {
   "text": "Tiny droplets",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 43.61,
   "t1": 47.722
  },
  {
   "text": "9 in 10 catch it",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 48.172,
   "t1": 50.364
  },
  {
   "text": "One cough is enough",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 50.814,
   "t1": 53.006
  },
  {
   "text": "Rinderpest and measles: brothers",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 58.73,
   "t1": 63.107
  },
  {
   "text": "About 2,500 years ago",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 63.557,
   "t1": 67.934
  },
  {
   "text": "He needs a big city",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 68.384,
   "t1": 71.772
  },
  {
   "text": "Cities made measles possible",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 72.222,
   "t1": 75.611
  },
  {
   "text": "A village runs out of victims",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 76.061,
   "t1": 79.45
  },
  {
   "text": "Al-Razi, around 900",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 79.9,
   "t1": 83.352
  },
  {
   "text": "Measles and smallpox are different",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 83.802,
   "t1": 87.254
  },
  {
   "text": "What He Does to You",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 92.741,
   "t1": 96.727
  },
  {
   "text": "Fever, cough, red eyes",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 92.741,
   "t1": 96.727
  },
  {
   "text": "10 to 14 days later",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 97.177,
   "t1": 101.164
  },
  {
   "text": "White spots, then the rash",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 101.614,
   "t1": 103.974
  },
  {
   "text": "The rash",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 104.424,
   "t1": 106.785
  },
  {
   "text": "Days of fever",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 107.235,
   "t1": 109.595
  },
  {
   "text": "Ears, eyes, lungs, brain",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 110.045,
   "t1": 113.263
  },
  {
   "text": "Pneumonia",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 113.713,
   "t1": 116.931
  },
  {
   "text": "Ear infections",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 117.381,
   "t1": 120.599
  },
  {
   "text": "Immune amnesia",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 121.049,
   "t1": 131.559
  },
  {
   "text": "Mexico, 1531",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 137.915,
   "t1": 141.878
  },
  {
   "text": "Measles and smallpox crossed together",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 142.328,
   "t1": 146.292
  },
  {
   "text": "They came by ship",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 146.742,
   "t1": 150.705
  },
  {
   "text": "London, 1824",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 151.155,
   "t1": 157.019
  },
  {
   "text": "A long voyage to London",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 157.469,
   "t1": 163.333
  },
  {
   "text": "Faroe Islands, 1846",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 168.203,
   "t1": 173.185
  },
  {
   "text": "Remote islands in the North Atlantic",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 173.635,
   "t1": 178.617
  },
  {
   "text": "Peter Panum",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 179.067,
   "t1": 186.879
  },
  {
   "text": "Immune for life",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 187.329,
   "t1": 195.14
  },
  {
   "text": "Fiji, 1875",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 200.638,
   "t1": 205.729
  },
  {
   "text": "Perhaps a quarter died",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 206.179,
   "t1": 211.27
  },
  {
   "text": "Villages fell silent",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 211.72,
   "t1": 216.811
  },
  {
   "text": "3 to 4 million cases a year",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 217.261,
   "t1": 222.38
  },
  {
   "text": "Every family knew it",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 222.83,
   "t1": 227.949
  },
  {
   "text": "Boston, 1954",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 228.399,
   "t1": 231.647
  },
  {
   "text": "David Edmonston, 13",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 232.097,
   "t1": 235.346
  },
  {
   "text": "Growing the virus",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 235.796,
   "t1": 239.044
  },
  {
   "text": "1963: the vaccine",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 239.494,
   "t1": 243.173
  },
  {
   "text": "Maurice Hilleman, MMR",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 243.623,
   "t1": 247.302
  },
  {
   "text": "Queueing for the shot",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 247.752,
   "t1": 251.432
  },
  {
   "text": "Roald Dahl, 1986",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 251.882,
   "t1": 263.222
  },
  {
   "text": "What He Leaves Behind",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 268.195,
   "t1": 279.802
  },
  {
   "text": "Immunity, and a hidden cost",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 268.195,
   "t1": 279.802
  },
  {
   "text": "Herd immunity: 95 in 100",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 280.252,
   "t1": 285.987
  },
  {
   "text": "Protecting the ones who can't be vaccinated",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 286.437,
   "t1": 292.172
  },
  {
   "text": "A fraudulent study, 1998",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 296.931,
   "t1": 306.278
  },
  {
   "text": "Outbreaks return",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 306.728,
   "t1": 316.075
  },
  {
   "text": "About 95,000 deaths in 2024",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 316.525,
   "t1": 320.847
  },
  {
   "text": "Nearly 60 million lives saved",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 321.297,
   "t1": 325.619
  },
  {
   "text": "Vaccines on the move",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 326.069,
   "t1": 330.392
  },
  {
   "text": "NEXT TIME",
   "x": 1380,
   "y": 360,
