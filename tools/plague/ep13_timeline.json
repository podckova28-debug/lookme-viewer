  {
   "text": "Two hours in the air",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 38.556,
   "t1": 43.213
  },
  {
   "text": "He lingers in the air",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 43.663,
   "t1": 48.319
  },
  {
   "text": "Tiny droplets",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 48.769,
   "t1": 53.425
  },
  {
   "text": "9 in 10 catch it",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 53.875,
   "t1": 56.469
  },
  {
   "text": "One cough is enough",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 56.919,
   "t1": 59.512
  },
  {
   "text": "Rinderpest and measles: brothers",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 66.053,
   "t1": 71.048
  },
  {
   "text": "About 2,500 years ago",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 71.498,
   "t1": 76.493
  },
  {
   "text": "He needs a big city",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 76.943,
   "t1": 80.813
  },
  {
   "text": "Cities made measles possible",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 81.263,
   "t1": 85.133
  },
  {
   "text": "A village runs out of victims",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 85.583,
   "t1": 89.453
  },
  {
   "text": "Al-Razi, around 900",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 89.903,
   "t1": 93.882
  },
  {
   "text": "Measles and smallpox are different",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 94.332,
   "t1": 98.311
  },
  {
   "text": "What He Does to You",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 104.577,
   "t1": 109.14
  },
  {
   "text": "Fever, cough, red eyes",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 104.577,
   "t1": 109.14
  },
  {
   "text": "10 to 14 days later",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 109.59,
   "t1": 114.154
  },
  {
   "text": "White spots, then the rash",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 114.604,
   "t1": 117.335
  },
  {
   "text": "The rash",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 117.785,
   "t1": 120.516
  },
  {
   "text": "Days of fever",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 120.966,
   "t1": 123.698
  },
  {
   "text": "Ears, eyes, lungs, brain",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 124.148,
   "t1": 127.824
  },
  {
   "text": "Pneumonia",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 128.274,
   "t1": 131.95
  },
  {
   "text": "Ear infections",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 132.4,
   "t1": 136.077
  },
  {
   "text": "Immune amnesia",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 136.527,
   "t1": 148.394
  },
  {
   "text": "Mexico, 1531",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 155.619,
   "t1": 160.119
  },
  {
   "text": "Measles and smallpox crossed together",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 160.569,
   "t1": 165.068
  },
  {
   "text": "They came by ship",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 165.518,
   "t1": 170.017
  },
  {
   "text": "London, 1824",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 170.467,
   "t1": 177.102
  },
  {
   "text": "A long voyage to London",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 177.552,
   "t1": 184.186
  },
  {
   "text": "Faroe Islands, 1846",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 189.792,
   "t1": 195.453
  },
  {
   "text": "Remote islands in the North Atlantic",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 195.903,
   "t1": 201.565
  },
  {
   "text": "Peter Panum",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 202.015,
   "t1": 210.794
  },
  {
   "text": "Immune for life",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 211.244,
   "t1": 220.023
  },
  {
   "text": "Fiji, 1875",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 226.286,
   "t1": 232.024
  },
  {
   "text": "Perhaps a quarter died",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 232.474,
   "t1": 238.213
  },
  {
   "text": "Villages fell silent",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 238.663,
   "t1": 244.402
  },
  {
   "text": "3 to 4 million cases a year",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 244.852,
   "t1": 250.661
  },
  {
   "text": "Every family knew it",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 251.111,
   "t1": 256.921
  },
  {
   "text": "Boston, 1954",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 257.371,
   "t1": 261.087
  },
  {
   "text": "David Edmonston, 13",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 261.537,
   "t1": 265.252
  },
  {
   "text": "Growing the virus",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 265.702,
   "t1": 269.418
  },
  {
   "text": "1963: the vaccine",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 269.868,
   "t1": 274.051
  },
  {
   "text": "Maurice Hilleman, MMR",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 274.501,
   "t1": 278.683
  },
  {
   "text": "Queueing for the shot",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 279.133,
   "t1": 283.316
  },
  {
   "text": "Roald Dahl, 1986",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 283.766,
   "t1": 296.551
  },
  {
   "text": "What He Leaves Behind",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 302.258,
   "t1": 315.341
  },
  {
   "text": "Immunity, and a hidden cost",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 302.258,
   "t1": 315.341
  },
  {
   "text": "Herd immunity: 95 in 100",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 315.791,
   "t1": 322.289
  },
  {
   "text": "Protecting the ones who can't be vaccinated",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 322.739,
   "t1": 329.236
  },
  {
   "text": "A fraudulent study, 1998",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 334.703,
   "t1": 345.166
  },
  {
   "text": "Outbreaks return",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 345.616,
   "t1": 356.079
  },
  {
   "text": "About 95,000 deaths in 2024",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 356.529,
   "t1": 361.42
  },
  {
   "text": "Nearly 60 million lives saved",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 361.87,
   "t1": 366.761
  },
  {
   "text": "Vaccines on the move",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 367.211,
   "t1": 372.102
  },
  {
   "text": "NEXT TIME",
   "x": 1380,
   "y": 360,
   "size": 110,
   "style": "title",
   "pop": true,
   "t0": 403.033,
