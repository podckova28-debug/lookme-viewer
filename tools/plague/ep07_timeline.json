 "texts": [
  {
   "text": "BERLIN \u00b7 24 MARCH 1882",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 0.3,
   "t1": 2.936
  },
  {
   "text": "1 IN 7 DEATHS",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 12.643,
   "t1": 18.398
  },
  {
   "text": "BAD AIR? BAD BLOOD? WEAKNESS? VAMPIRES?",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 25.053,
   "t1": 29.665
  },
  {
   "text": "TUBERCULOSIS",
   "x": 1300,
   "y": 330,
   "size": 120,
   "style": "title",
   "pop": true,
   "t0": 39.997,
   "t1": 44.197
  },
  {
   "text": "THE WHITE PLAGUE",
   "x": 1300,
   "y": 460,
   "size": 72,
   "style": "title",
   "color": [
    190,
    205,
    230
   ],
   "t0": 40.347,
   "t1": 44.247
  },
  {
   "text": "MOST BACTERIA: 20 MINUTES  \u00b7  TB: ABOUT A DAY",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 58.064,
   "t1": 66.18
  },
  {
   "text": "THROUGH THE AIR",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 66.63,
   "t1": 70.206
  },
  {
   "text": "TUBERCLES: SHE SLEEPS FOR YEARS",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 83.814,
   "t1": 88.989
  },
  {
   "text": "ABOUT 1 IN 4 PEOPLE CARRY HER",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 89.439,
   "t1": 94.613
  },
  {
   "text": "OUT OF AFRICA?",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 104.341,
   "t1": 109.29
  },
  {
   "text": "TB OF THE SPINE",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 125.252,
   "t1": 129.516
  },
  {
   "text": "WHAT SHE DOES TO YOU",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 141.465,
   "t1": 144.344
  },
  {
   "text": "A COUGH FOR WEEKS  \u00b7  TIREDNESS  \u00b7  FEVER",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 141.465,
   "t1": 144.344
  },
  {
   "text": "CONSUMPTION: IT CONSUMED YOU",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 151.452,
   "t1": 156.331
  },
  {
   "text": "HOLES IN THE LUNGS",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 162.109,
   "t1": 165.85
  },
  {
   "text": "LUNGS  \u00b7  BONES  \u00b7  NECK  \u00b7  BRAIN",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 174.681,
   "t1": 179.975
  },
  {
   "text": "WITHOUT TREATMENT: ABOUT HALF DIE",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 186.168,
   "t1": 189.191
  },
  {
   "text": "THE ROYAL TOUCH",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 215.657,
   "t1": 219.29
  },
  {
   "text": "CHARLES II",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 223.824,
   "t1": 227.255
  },
  {
   "text": "ABOUT 90,000 TOUCHES",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 227.705,
   "t1": 231.136
  },
  {
   "text": "1 IN 4 DEATHS IN PARTS OF EUROPE",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 240.188,
   "t1": 243.415
  },
  {
   "text": "THE CONSUMPTIVE LOOK",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 254.165,
   "t1": 260.34
  },
  {
   "text": "JOHN KEATS \u00b7 1821",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 260.79,
   "t1": 263.841
  },
  {
   "text": "FREDERIC CHOPIN \u00b7 1849",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 264.291,
   "t1": 267.342
  },
  {
   "text": "RHODE ISLAND \u00b7 1892",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 279.691,
   "t1": 285.163
  },
  {
   "text": "STAIN  \u00b7  SEE  \u00b7  GROW  \u00b7  PROVE",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 303.716,
   "t1": 307.125
  },
  {
   "text": "24 MARCH: WORLD TB DAY",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 320.839,
   "t1": 325.938
  },
  {
   "text": "NOT A CURE  \u00b7  BUT A TEST",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 326.388,
   "t1": 337.661
  },
  {
   "text": "DAVOS, SWITZERLAND",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 343.04,
   "t1": 345.916
  },
  {
   "text": "REST  \u00b7  FOOD  \u00b7  FRESH AIR",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 349.692,
   "t1": 352.569
  },
  {
   "text": "230 TIMES  \u00b7  13 YEARS  \u00b7  BCG",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 373.005,
   "t1": 377.86
  },
  {
   "text": "NEW JERSEY \u00b7 1943",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 393.947,
   "t1": 397.278
  },
  {
   "text": "SOIL  \u00b7  BACTERIA  \u00b7  STREPTOMYCIN",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 401.509,
   "t1": 404.839
  },
  {
   "text": "SEVERAL DRUGS  \u00b7  MONTHS  \u00b7  CURED",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 409.07,
   "t1": 413.829
  },
  {
   "text": "CASES FALL",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 419.487,
   "t1": 422.371
  },
  {
   "text": "WEAKENED DEFENCES  \u00b7  DRUG RESISTANCE",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 435.062,
   "t1": 441.272
  },
  {
   "text": "10 MILLION SICK  \u00b7  OVER 1 MILLION DEATHS A YEAR",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 448.382,
   "t1": 451.927
  },
  {
   "text": "6 MONTHS OF PILLS  \u00b7  CURED",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 460.367,
   "t1": 464.842
  },
  {
   "text": "WHAT SHE LEAVES BEHIND",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 470.217,
   "t1": 474.985
  },
  {
   "text": "SCARRED LUNGS  \u00b7  SHE CAN WAKE AGAIN",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 470.217,
   "t1": 474.985
  },
  {
   "text": "ARCHITECTURE  \u00b7  CONTACT TRACING  \u00b7  SCREENING",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 488.714,
   "t1": 496.325
  },
  {
   "text": "NEXT TIME",
   "x": 1380,
   "y": 360,
   "size": 110,
   "style": "title",
   "pop": true,
   "t0": 523.861,
   "t1": 528.461
  },
  {
   "text": "SUBSCRIBE",
