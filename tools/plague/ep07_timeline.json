 ],
 "texts": [
  {
   "text": "Robert Koch",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 6.676,
   "t1": 9.414
  },
  {
   "text": "Berlin \u2014 24 March 1882",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 9.864,
   "t1": 12.602
  },
  {
   "text": "One in seven deaths",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 13.052,
   "t1": 18.807
  },
  {
   "text": "Nobody claps",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 19.257,
   "t1": 25.012
  },
  {
   "text": "They called it the white plague",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 25.462,
   "t1": 30.074
  },
  {
   "text": "Blamed on bad air, even vampires",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 30.524,
   "t1": 35.137
  },
  {
   "text": "TUBERCULOSIS",
   "x": 1300,
   "y": 330,
   "size": 120,
   "style": "title",
   "pop": true,
   "t0": 40.406,
   "t1": 44.606
  },
  {
   "text": "THE WHITE PLAGUE",
   "x": 1300,
   "y": 460,
   "size": 72,
   "style": "title",
   "color": [
    190,
    205,
    230
   ],
   "t0": 40.756,
   "t1": 44.656
  },
  {
   "text": "Most bacteria: 20 minutes. She takes a day",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 58.473,
   "t1": 66.588
  },
  {
   "text": "She travels through the air",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 67.038,
   "t1": 70.615
  },
  {
   "text": "One cough in a crowded room",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 71.065,
   "t1": 74.642
  },
  {
   "text": "Walled up in tubercles, she sleeps for years",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 84.223,
   "t1": 89.398
  },
  {
   "text": "About one in four people carry her",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 89.848,
   "t1": 95.022
  },
  {
   "text": "Most carriers never get sick",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 95.472,
   "t1": 100.647
  },
  {
   "text": "Out of Africa?",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 104.75,
   "t1": 109.699
  },
  {
   "text": "Tens of thousands of years ago",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 110.149,
   "t1": 115.098
  },
  {
   "text": "Long before cities",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 115.548,
   "t1": 120.497
  },
  {
   "text": "The mummies of ancient Egypt",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 120.947,
   "t1": 125.211
  },
  {
   "text": "Tuberculosis of the spine",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 125.661,
   "t1": 129.924
  },
  {
   "text": "The first crowded towns",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 130.375,
   "t1": 136.334
  },
  {
   "text": "What She Does to You",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 141.873,
   "t1": 144.753
  },
  {
   "text": "A cough that won't go away",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 141.873,
   "t1": 144.753
  },
  {
   "text": "A fever every evening",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 148.532,
   "t1": 151.411
  },
  {
   "text": "Consumption: it consumed you",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 151.861,
   "t1": 156.739
  },
  {
   "text": "Night sweats",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 157.189,
   "t1": 162.068
  },
  {
   "text": "She carves holes in the lungs",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 162.518,
   "t1": 166.258
  },
  {
   "text": "Often the first sign",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 166.708,
   "t1": 170.449
  },
  {
   "text": "Not just the lungs",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 175.09,
   "t1": 180.384
  },
  {
   "text": "Scrofula",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 180.834,
   "t1": 186.127
  },
  {
   "text": "Untreated, about half die",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 186.577,
   "t1": 189.6
  },
  {
   "text": "Ancient Greece: phthisis, \"the wasting\"",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 198.154,
   "t1": 202.313
  },
  {
   "text": "Hippocrates",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 202.763,
   "t1": 206.923
  },
  {
   "text": "The King's Evil",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 211.982,
   "t1": 215.616
  },
  {
   "text": "The royal touch",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 216.066,
   "t1": 219.699
  },
  {
   "text": "King Charles II of England",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 224.233,
   "t1": 227.664
  },
  {
   "text": "About 90,000 people touched",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 228.114,
   "t1": 231.545
  },
  {
   "text": "The factory towns of the 1800s",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 236.921,
   "t1": 240.147
  },
  {
   "text": "One in four deaths in parts of Europe",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 240.597,
   "t1": 243.823
  },
  {
   "text": "Damp rooms, no fresh air",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 244.273,
   "t1": 247.5
  },
  {
   "text": "Pale was beautiful",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 247.95,
   "t1": 254.124
  },
  {
   "text": "The consumptive look",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 254.574,
   "t1": 260.749
  },
  {
   "text": "John Keats, dead at 25",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 261.199,
   "t1": 264.25
  },
  {
   "text": "Fr\u00e9d\u00e9ric Chopin \u2014 1849",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 264.7,
   "t1": 267.751
  },
  {
   "text": "La Traviata",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 268.201,
   "t1": 271.253
  },
  {
   "text": "Rhode Island \u2014 1892",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 280.1,
   "t1": 285.572
  },
  {
   "text": "They dug up Mercy Brown",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 286.022,
   "t1": 291.494
  },
  {
   "text": "He died anyway",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 291.944,
   "t1": 297.417
  },
  {
   "text": "From a stain to proof",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 304.125,
   "t1": 307.533
  },
  {
   "text": "Nobel Prize, 1905",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 315.7,
   "t1": 320.798
  },
  {
   "text": "24 March is now World TB Day",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 321.248,
   "t1": 326.347
  },
  {
   "text": "Not a cure, but a test",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 326.797,
   "t1": 338.07
  },
  {
   "text": "Davos, Switzerland",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 343.449,
   "t1": 346.325
  },
  {
   "text": "For months, even years",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 346.775,
   "t1": 349.651
  },
  {
   "text": "The prescription: fresh air",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 350.101,
   "t1": 352.977
  },
  {
   "text": "Many never came home",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 356.754,
   "t1": 362.661
  },
  {
   "text": "Calmette and Gu\u00e9rin, 1921",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 368.108,
   "t1": 372.963
  },
  {
   "text": "Grown 230 times over 13 years",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 373.413,
   "t1": 378.269
  },
  {
   "text": "Still given to millions of babies",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 384.025,
   "t1": 393.906
  },
  {
   "text": "New Jersey \u2014 1943",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 394.356,
   "t1": 397.687
  },
  {
   "text": "Albert Schatz",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 398.137,
   "t1": 401.467
  },
  {
   "text": "A cure from the soil",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 401.917,
   "t1": 405.248
  },
  {
   "text": "Several drugs, taken for months",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 409.479,
   "t1": 414.237
  },
  {
   "text": "Finally, a cure",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 414.687,
   "t1": 419.446
  },
  {
   "text": "Cases fall, year after year",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 419.896,
   "t1": 422.78
  },
  {
   "text": "X-rays for whole towns",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 423.23,
   "t1": 426.115
  },
  {
   "text": "She learned to survive the drugs",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 435.471,
   "t1": 441.681
  },
  {
   "text": "Stopping the pills too early",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 442.131,
   "t1": 448.341
  },
  {
   "text": "Over 10 million fall ill every year",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 448.791,
   "t1": 452.336
  },
  {
   "text": "Mostly in Asia and Africa",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 452.786,
   "t1": 456.331
  },
  {
   "text": "Over a million die every year",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 456.781,
   "t1": 460.326
  },
  {
   "text": "Six months of cheap pills",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 460.776,
   "t1": 465.251
  },
  {
   "text": "The hard part: reaching people",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 465.701,
   "t1": 470.175
  },
  {
   "text": "What She Leaves Behind",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 470.625,
   "t1": 475.394
  },
  {
   "text": "She can wake again",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 470.625,
   "t1": 475.394
  },
  {
   "text": "Short of breath for life",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 475.844,
   "t1": 480.612
  },
  {
   "text": "White walls, big windows, sunlight",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 481.062,
   "t1": 488.673
  },
  {
   "text": "She left more than graves",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 489.123,
   "t1": 496.733
  },
