 ],
 "texts": [
  {
   "text": "Robert Koch",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 5.972,
   "t1": 8.358
  },
  {
   "text": "Berlin \u2014 24 March 1882",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 8.808,
   "t1": 11.194
  },
  {
   "text": "One in seven deaths",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 11.644,
   "t1": 16.713
  },
  {
   "text": "Nobody claps",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 17.163,
   "t1": 22.231
  },
  {
   "text": "They called it the white plague",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 22.681,
   "t1": 26.709
  },
  {
   "text": "Blamed on bad air, even vampires",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 27.159,
   "t1": 31.187
  },
  {
   "text": "TUBERCULOSIS",
   "x": 1300,
   "y": 330,
   "size": 120,
   "style": "title",
   "pop": true,
   "t0": 35.755,
   "t1": 39.955
  },
  {
   "text": "THE WHITE PLAGUE",
   "x": 1300,
   "y": 460,
   "size": 72,
   "style": "title",
   "color": [
    190,
    205,
    230
   ],
   "t0": 36.105,
   "t1": 40.005
  },
  {
   "text": "Most bacteria: 20 minutes. She takes a day",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 52.35,
   "t1": 59.441
  },
  {
   "text": "She travels through the air",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 59.891,
   "t1": 63.018
  },
  {
   "text": "One cough in a crowded room",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 63.468,
   "t1": 66.595
  },
  {
   "text": "Walled up in tubercles, she sleeps for years",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 75.005,
   "t1": 79.587
  },
  {
   "text": "About one in four people carry her",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 80.037,
   "t1": 84.618
  },
  {
   "text": "Most carriers never get sick",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 85.068,
   "t1": 89.65
  },
  {
   "text": "Out of Africa?",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 93.174,
   "t1": 97.547
  },
  {
   "text": "Tens of thousands of years ago",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 97.997,
   "t1": 102.37
  },
  {
   "text": "Long before cities",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 102.82,
   "t1": 107.194
  },
  {
   "text": "The mummies of ancient Egypt",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 107.644,
   "t1": 111.354
  },
  {
   "text": "Tuberculosis of the spine",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 111.804,
   "t1": 115.514
  },
  {
   "text": "The first crowded towns",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 115.964,
   "t1": 121.088
  },
  {
   "text": "What She Does to You",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 125.919,
   "t1": 128.414
  },
  {
   "text": "A cough that won't go away",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 125.919,
   "t1": 128.414
  },
  {
   "text": "A fever every evening",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 131.81,
   "t1": 134.305
  },
  {
   "text": "Consumption: it consumed you",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 134.755,
   "t1": 139.027
  },
  {
   "text": "Night sweats",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 139.477,
   "t1": 143.75
  },
  {
   "text": "She carves holes in the lungs",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 144.2,
   "t1": 147.337
  },
  {
   "text": "Often the first sign",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 147.787,
   "t1": 150.924
  },
  {
   "text": "Not just the lungs",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 154.961,
   "t1": 159.608
  },
  {
   "text": "Scrofula",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 160.058,
   "t1": 164.705
  },
  {
   "text": "Untreated, about half die",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 165.155,
   "t1": 167.736
  },
  {
   "text": "Ancient Greece: phthisis, \"the wasting\"",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 175.183,
   "t1": 178.838
  },
  {
   "text": "Hippocrates",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 179.288,
   "t1": 182.943
  },
  {
   "text": "The King's Evil",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 187.498,
   "t1": 190.678
  },
  {
   "text": "The royal touch",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 191.128,
   "t1": 194.307
  },
  {
   "text": "King Charles II of England",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 198.386,
   "t1": 201.328
  },
  {
   "text": "About 90,000 people touched",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 201.778,
   "t1": 204.72
  },
  {
   "text": "The factory towns of the 1800s",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 209.404,
   "t1": 212.215
  },
  {
   "text": "One in four deaths in parts of Europe",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 212.665,
   "t1": 215.477
  },
  {
   "text": "Damp rooms, no fresh air",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 215.927,
   "t1": 218.738
  },
  {
   "text": "Pale was beautiful",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 219.188,
   "t1": 224.641
  },
  {
   "text": "The consumptive look",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 225.091,
   "t1": 230.543
  },
  {
   "text": "John Keats, dead at 25",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 230.993,
   "t1": 233.664
  },
  {
   "text": "Fr\u00e9d\u00e9ric Chopin \u2014 1849",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 234.114,
   "t1": 236.784
  },
  {
   "text": "La Traviata",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 237.234,
   "t1": 239.905
  },
  {
   "text": "Rhode Island \u2014 1892",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 247.678,
   "t1": 252.529
  },
  {
   "text": "They dug up Mercy Brown",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 252.979,
   "t1": 257.83
  },
  {
   "text": "He died anyway",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 258.28,
   "t1": 263.131
  },
  {
   "text": "From a stain to proof",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 269.011,
   "t1": 271.981
  },
  {
   "text": "Nobel Prize, 1905",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 279.27,
   "t1": 283.739
  },
  {
   "text": "24 March is now World TB Day",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 284.189,
   "t1": 288.658
  },
  {
   "text": "Not a cure, but a test",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 289.108,
   "t1": 299.059
  },
  {
   "text": "Davos, Switzerland",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 303.727,
   "t1": 306.24
  },
  {
   "text": "For months, even years",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 306.69,
   "t1": 309.204
  },
  {
   "text": "The prescription: fresh air",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 309.654,
   "t1": 312.168
  },
  {
   "text": "Many never came home",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 315.582,
   "t1": 320.658
  },
  {
   "text": "Calmette and Gu\u00e9rin, 1921",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 325.397,
   "t1": 329.687
  },
  {
   "text": "Grown 230 times over 13 years",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 330.137,
   "t1": 334.426
  },
  {
   "text": "Still given to millions of babies",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 339.616,
   "t1": 348.312
  },
  {
   "text": "New Jersey \u2014 1943",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 348.762,
   "t1": 351.687
  },
  {
   "text": "Albert Schatz",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 352.137,
   "t1": 355.061
  },
  {
   "text": "A cure from the soil",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 355.511,
   "t1": 358.436
  },
  {
   "text": "Several drugs, taken for months",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 362.26,
   "t1": 366.421
  },
  {
   "text": "Finally, a cure",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 366.871,
   "t1": 371.031
  },
  {
   "text": "Cases fall, year after year",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 371.481,
   "t1": 373.979
  },
  {
   "text": "X-rays for whole towns",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 374.429,
   "t1": 376.926
  },
  {
   "text": "She learned to survive the drugs",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 385.147,
   "t1": 390.624
  },
  {
   "text": "Stopping the pills too early",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 391.074,
   "t1": 396.551
  },
  {
   "text": "Over 10 million fall ill every year",
   "x": 960,
   "y": 985,
