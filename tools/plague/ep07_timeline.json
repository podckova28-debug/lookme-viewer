 ],
 "texts": [
  {
   "text": "Robert Koch",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 5.972,
   "t1": 8.358
  },
  {
   "text": "Berlin \u2014 24 March 1882",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 8.808,
   "t1": 11.194
  },
  {
   "text": "One in seven deaths",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 11.644,
   "t1": 16.713
  },
  {
   "text": "Nobody claps",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 17.163,
   "t1": 22.231
  },
  {
   "text": "They called it the white plague",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 22.681,
   "t1": 26.709
  },
  {
   "text": "Blamed on bad air, even vampires",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 27.159,
   "t1": 31.187
  },
  {
   "text": "TUBERCULOSIS",
   "x": 1300,
   "y": 330,
   "size": 120,
   "style": "title",
   "pop": true,
   "t0": 35.755,
   "t1": 39.955
  },
  {
   "text": "THE WHITE PLAGUE",
   "x": 1300,
   "y": 460,
   "size": 72,
   "style": "title",
   "color": [
    190,
    205,
    230
   ],
   "t0": 36.105,
   "t1": 40.005
  },
  {
   "text": "Most bacteria: 20 minutes. She takes a day",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 52.35,
   "t1": 59.441
  },
  {
   "text": "She travels through the air",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 59.891,
   "t1": 63.018
  },
  {
   "text": "One cough in a crowded room",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 63.468,
   "t1": 66.595
  },
  {
   "text": "Walled up in tubercles, she sleeps for years",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 75.005,
   "t1": 79.587
  },
  {
   "text": "About one in four people carry her",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 80.037,
   "t1": 84.618
  },
  {
   "text": "Most carriers never get sick",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 85.068,
   "t1": 89.65
  },
  {
   "text": "Out of Africa?",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 93.174,
   "t1": 97.547
  },
  {
   "text": "Tens of thousands of years ago",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 97.997,
   "t1": 102.37
  },
  {
   "text": "Long before cities",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 102.82,
   "t1": 107.194
  },
  {
   "text": "The mummies of ancient Egypt",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 107.644,
   "t1": 111.354
  },
  {
   "text": "Tuberculosis of the spine",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 111.804,
   "t1": 115.514
  },
  {
   "text": "The first crowded towns",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 115.964,
   "t1": 121.088
  },
  {
   "text": "What She Does to You",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 125.919,
   "t1": 128.414
  },
  {
   "text": "A cough that won't go away",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 125.919,
   "t1": 128.414
  },
  {
   "text": "A fever every evening",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 131.81,
   "t1": 134.305
  },
  {
   "text": "Consumption: it consumed you",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 134.755,
   "t1": 139.027
  },
  {
   "text": "Night sweats",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 139.477,
   "t1": 143.75
  },
  {
   "text": "She carves holes in the lungs",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 144.2,
   "t1": 147.478
  },
  {
   "text": "Often the first sign",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 147.928,
   "t1": 151.207
  },
  {
   "text": "Not just the lungs",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 155.385,
   "t1": 160.033
  },
  {
   "text": "Scrofula",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 160.483,
   "t1": 165.13
  },
  {
   "text": "Untreated, about half die",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 165.58,
   "t1": 168.161
  },
  {
   "text": "Ancient Greece: phthisis, \"the wasting\"",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 175.607,
   "t1": 179.262
  },
  {
   "text": "Hippocrates",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 179.712,
   "t1": 183.368
  },
  {
   "text": "The King's Evil",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 187.923,
   "t1": 191.102
  },
  {
   "text": "The royal touch",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 191.552,
   "t1": 194.731
  },
  {
   "text": "King Charles II of England",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 198.811,
   "t1": 201.752
  },
  {
   "text": "About 90,000 people touched",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 202.202,
   "t1": 205.144
  },
  {
   "text": "The factory towns of the 1800s",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 209.828,
   "t1": 212.639
  },
  {
   "text": "One in four deaths in parts of Europe",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 213.089,
   "t1": 215.901
  },
  {
   "text": "Damp rooms, no fresh air",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 216.351,
   "t1": 219.162
  },
  {
   "text": "Pale was beautiful",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 219.612,
   "t1": 225.065
  },
  {
   "text": "The consumptive look",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 225.515,
   "t1": 230.967
  },
  {
   "text": "John Keats, dead at 25",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 231.417,
   "t1": 234.088
  },
  {
   "text": "Fr\u00e9d\u00e9ric Chopin \u2014 1849",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 234.538,
   "t1": 237.209
  },
  {
   "text": "La Traviata",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 237.659,
   "t1": 240.329
  },
  {
   "text": "Rhode Island \u2014 1892",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 248.103,
   "t1": 252.954
  },
  {
   "text": "They dug up Mercy Brown",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 253.404,
   "t1": 258.255
  },
  {
   "text": "He died anyway",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 258.705,
   "t1": 263.556
  },
  {
   "text": "From a stain to proof",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 269.435,
   "t1": 272.405
  },
  {
   "text": "Nobel Prize, 1905",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 279.694,
   "t1": 284.163
  },
  {
   "text": "24 March is now World TB Day",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 284.613,
   "t1": 289.083
  },
  {
   "text": "Not a cure, but a test",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 289.533,
   "t1": 299.483
  },
  {
   "text": "Davos, Switzerland",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 304.151,
   "t1": 306.665
  },
  {
   "text": "For months, even years",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 307.115,
   "t1": 309.628
  },
  {
   "text": "The prescription: fresh air",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 310.078,
   "t1": 312.592
  },
  {
   "text": "Many never came home",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 316.006,
   "t1": 321.083
  },
  {
   "text": "Calmette and Gu\u00e9rin, 1921",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 325.821,
   "t1": 330.111
  },
  {
   "text": "Grown 230 times over 13 years",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 330.561,
   "t1": 334.851
  },
  {
   "text": "Still given to millions of babies",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 340.041,
   "t1": 348.736
  },
  {
   "text": "New Jersey \u2014 1943",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 349.186,
   "t1": 352.111
  },
  {
   "text": "Albert Schatz",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 352.561,
   "t1": 355.485
  },
  {
   "text": "A cure from the soil",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 355.935,
   "t1": 358.86
  },
  {
   "text": "Several drugs, taken for months",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 362.685,
   "t1": 366.845
  },
  {
   "text": "Finally, a cure",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 367.295,
   "t1": 371.455
  },
  {
   "text": "Cases fall, year after year",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 371.905,
   "t1": 374.403
  },
  {
   "text": "X-rays for whole towns",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 374.853,
   "t1": 377.351
  },
  {
   "text": "She learned to survive the drugs",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 385.571,
   "t1": 391.048
  },
  {
   "text": "Stopping the pills too early",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 391.498,
   "t1": 396.975
  },
  {
   "text": "Over 10 million fall ill every year",
   "x": 960,
   "y": 985,
