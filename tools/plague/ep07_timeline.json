  },
  {
   "text": "Mostly in Asia and Africa",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 400.974,
   "t1": 404.072
  },
  {
   "text": "Over a million die every year",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 404.522,
   "t1": 407.621
  },
  {
   "text": "Six months of cheap pills",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 408.071,
   "t1": 411.971
  },
  {
   "text": "The hard part: reaching people",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 412.421,
   "t1": 416.321
  },
  {
   "text": "What She Leaves Behind",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 416.771,
   "t1": 420.931
  },
  {
   "text": "She can wake again",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 416.771,
   "t1": 420.931
  },
  {
   "text": "Short of breath for life",
