   "size": 50,
   "t0": 407.646,
   "t1": 411.546
  },
  {
   "text": "The hard part: reaching people",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 411.996,
   "t1": 415.896
  },
  {
   "text": "What She Leaves Behind",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 416.346,
   "t1": 420.506
  },
  {
   "text": "She can wake again",
