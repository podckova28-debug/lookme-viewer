   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 69.068,
   "t1": 71.754
  },
  {
   "text": "RATTUS RATTUS",
   "x": 1300,
   "y": 760,
   "size": 76,
   "t0": 75.34,
   "t1": 78.176
  },
  {
   "text": "(yes, really)",
   "x": 1300,
   "y": 900,
   "size": 56,
   "t0": 78.626,
   "t1": 81.462
  },
  {
   "text": "THE MENU",
   "x": 960,
   "y": 105,
   "size": 56,
   "t0": 86.054,
   "t1": 89.909
  },
  {
   "text": "Lumps, blood, lungs",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 98.968,
   "t1": 102.823
  },
  {
   "text": "Bubonic: about half. Pneumonic: almost all",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 106.013,
   "t1": 108.302
  },
  {
   "text": "Fever, chills, headache",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 111.492,
   "t1": 115.164
  },
  {
   "text": "What He Does to You",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 111.492,
   "t1": 115.164
  },
  {
   "text": "2 to 7 days after the bite",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 115.614,
   "t1": 119.287
  },
  {
   "text": "Buboes: neck, armpit, groin",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 119.737,
   "t1": 127.965
  },
  {
