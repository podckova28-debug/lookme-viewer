   "y": 985,
   "size": 50,
   "t0": 175.898,
   "t1": 178.888
  },
  {
   "text": "Emperor Justinian",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 179.338,
   "t1": 181.666
  },
  {
   "text": "Up to 10,000 a day",
