   "y": 985,
   "size": 50,
   "t0": 128.415,
   "t1": 136.478
  },
  {
   "text": "Pneumonic: no rats needed",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 136.928,
   "t1": 141.597
  },
  {
   "text": "Ancient skeletons",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 151.109,
   "t1": 159.155
  },
  {
   "text": "His DNA, hidden in ancient teeth",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 162.879,
   "t1": 165.703
  },
  {
   "text": "CONSTANTINOPLE \u00b7 541 AD",
