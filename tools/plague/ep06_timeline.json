 "texts": [
  {
   "text": "PARIS \u00b7 6 JULY 1885",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 0.3,
   "t1": 4.384
  },
  {
   "text": "ONCE SYMPTOMS BEGIN: ALMOST ALWAYS FATAL",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 16.276,
   "t1": 18.198
  },
  {
   "text": "RABIES",
   "x": 1300,
   "y": 330,
   "size": 150,
   "style": "title",
   "pop": true,
   "t0": 36.212,
   "t1": 40.412
  },
  {
   "text": "4,000 YEARS OF MADNESS",
   "x": 1300,
   "y": 470,
   "size": 68,
   "style": "title",
   "color": [
    235,
    210,
    110
   ],
   "t0": 36.562,
   "t1": 40.462
  },
  {
   "text": "THE RABIES VIRUS",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 45.471,
   "t1": 49.531
  },
  {
   "text": "LYSSA: RAGE AND MADNESS",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 49.981,
   "t1": 54.041
  },
  {
   "text": "DOGS: ALMOST EVERY HUMAN CASE",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 54.491,
   "t1": 61.201
  },
  {
   "text": "ALONG THE NERVES  \u00b7  WEEKS TO MONTHS",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 68.81,
   "t1": 72.564
  },
  {
   "text": "BRAIN  \u00b7  THEN SALIVA",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 81.42,
   "t1": 86.04
  },
  {
   "text": "BATS FIRST  \u00b7  THEN DOGS AND FOXES",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 99.619,
   "t1": 103.388
  },
  {
   "text": "15,000 YEARS OF DOGS",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 112.424,
   "t1": 116.339
  },
  {
   "text": "WHAT HE DOES TO YOU",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 119.74,
   "t1": 125.789
  },
  {
   "text": "FEVER  \u00b7  HEADACHE  \u00b7  TINGLING AT THE BITE",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 119.74,
   "t1": 125.789
  },
  {
   "text": "CONFUSION  \u00b7  TERROR  \u00b7  HALLUCINATIONS",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 132.738,
   "t1": 135.425
  },
  {
   "text": "HYDROPHOBIA: FEAR OF WATER",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 142.148,
   "t1": 147.654
  },
  {
   "text": "NO SWALLOWING  \u00b7  SALIVA FULL OF VIRUS",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 160.014,
   "t1": 164.064
  },
  {
   "text": "THE QUIET FORM: PARALYSIS",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 169.013,
   "t1": 173.594
  },
  {
   "text": "THE LAWS OF ESHNUNNA \u00b7 ABOUT 1800 BC",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 183.563,
   "t1": 187.795
  },
  {
   "text": "A MAD DOG  \u00b7  A BITE  \u00b7  A FINE IN SILVER",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 188.245,
   "t1": 192.477
  },
  {
   "text": "A HOT IRON  \u00b7  THE DOG'S LIVER  \u00b7  THE POND",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 203.645,
   "t1": 209.231
  },
  {
   "text": "\"THE HAIR OF THE DOG THAT BIT YOU\"",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 209.681,
   "t1": 215.006
  },
  {
   "text": "SAINT HUBERT'S KEY",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 230.085,
   "t1": 233.318
  },
  {
   "text": "WEREWOLVES?  \u00b7  VAMPIRES?",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 243.914,
   "t1": 249.928
  },
  {
   "text": "MUZZLES  \u00b7  QUARANTINE  \u00b7  GONE BY 1902",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 266.9,
   "t1": 270.398
  },
  {
   "text": "LOUIS PASTEUR",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 278.745,
   "t1": 282.459
  },
  {
   "text": "GERMS  \u00b7  ANTHRAX  \u00b7  RABIES?",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 282.909,
   "t1": 286.623
  },
  {
   "text": "THE LONGER IT DRIES, THE WEAKER HE GETS",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 291.237,
   "t1": 297.934
  },
  {
   "text": "WEAK  \u00b7  STRONGER  \u00b7  STRONGEST",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 305.531,
   "t1": 309.876
  },
  {
   "text": "13 INJECTIONS IN 10 DAYS",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 322.326,
   "t1": 325.17
  },
  {
   "text": "SMOLENSK TO PARIS \u00b7 1886",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 353.878,
   "t1": 358.599
  },
  {
   "text": "THE PASTEUR INSTITUTE \u00b7 1888",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 359.049,
   "t1": 363.77
  },
  {
   "text": "VACCINATE THE DOGS  \u00b7  PROTECT THE PEOPLE",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 378.056,
   "t1": 381.119
  },
  {
   "text": "WASH  \u00b7  VACCINE  \u00b7  ANTIBODIES",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 385.082,
   "t1": 391.335
  },
  {
   "text": "WISCONSIN \u00b7 2004",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 398.489,
   "t1": 403.312
  },
  {
   "text": "A FEW SURVIVORS  \u00b7  ALMOST ALL ARE LOST",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 414.309,
   "t1": 424.076
  },
  {
   "text": "WHAT HE LEAVES BEHIND",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 429.074,
   "t1": 434.828
  },
  {
   "text": "FEW SURVIVORS  \u00b7  MOSTLY BRAIN DAMAGE",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 429.074,
   "t1": 434.828
  },
  {
   "text": "LAB VACCINES  \u00b7  PASTEUR INSTITUTES  \u00b7  DOG LAWS",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 441.482,
   "t1": 447.452
  },
  {
   "text": "ABOUT 59,000 DEATHS A YEAR",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 460.423,
   "t1": 463.883
  },
  {
   "text": "ZERO BY 2030",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 472.153,
   "t1": 476.144
  },
  {
   "text": "A DOG BITE  \u00b7  A BAT BITE",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 486.576,
   "t1": 491.668
  },
