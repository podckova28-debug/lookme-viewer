   "size": 72,
   "style": "title",
   "color": [
    220,
    120,
    110
   ],
   "t0": 42.055,
   "t1": 45.955
  },
  {
   "text": "Rickettsia prowazekii",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 52.803,
   "t1": 58.7
  },
  {
   "text": "The itch does the rest",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 59.15,
   "t1": 63.435
  },
  {
   "text": "Scratch, scratch",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 63.885,
   "t1": 68.169
  },
  {
   "text": "Hiding in the seams",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 68.619,
   "t1": 72.903
  },
  {
   "text": "Soldiers, prisoners, refugees",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 73.353,
   "t1": 78.036
  },
  {
   "text": "No baths, no clean clothes",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 78.486,
   "t1": 83.168
  },
  {
   "text": "Clothes made a new home for lice",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 89.159,
   "t1": 97.077
  },
  {
   "text": "About 100,000 years ago",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 97.527,
   "t1": 105.445
  },
  {
   "text": "Typhus is not typhoid",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 105.895,
   "t1": 119.106
  },
  {
   "text": "What He Does to You",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 125.976,
   "t1": 129.564
  },
  {
   "text": "Fever, headache, aching muscles",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 125.976,
   "t1": 129.564
  },
  {
   "text": "A crushing headache",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 130.014,
   "t1": 133.603
  },
  {
   "text": "A rash that spreads outward",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 134.053,
   "t1": 137.684
  },
  {
   "text": "The rash",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 138.134,
   "t1": 141.765
  },
  {
   "text": "The haze",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 142.215,
   "t1": 147.64
  },
  {
   "text": "Up to 4 in 10 died",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 148.09,
   "t1": 153.515
  },
  {
   "text": "He can wake up decades later",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 153.965,
   "t1": 162.002
  },
  {
   "text": "Granada, 1489",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 169.052,
   "t1": 175.08
  },
  {
   "text": "17,000 to fever, 3,000 to swords",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 175.53,
   "t1": 181.559
  },
  {
   "text": "Camp fever, war fever, ship fever",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 182.009,
   "t1": 186.67
  },
  {
   "text": "Ship fever",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 187.12,
   "t1": 191.782
  },
  {
   "text": "Oxford, 1577: the Black Assize",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 192.232,
   "t1": 206.128
  },
  {
   "text": "Summer 1812",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 211.439,
   "t1": 223.431
  },
  {
   "text": "The lice moved with the coats",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 223.881,
   "t1": 227.529
  },
  {
   "text": "About 600,000 went in, few came back",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 227.979,
   "t1": 231.627
  },
  {
   "text": "Vilnius, December 1812",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 232.077,
   "t1": 235.726
  },
  {
   "text": "Ireland, 1847: the coffin ships",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 240.767,
   "t1": 253.52
  },
  {
   "text": "Grosse \u00cele, Canada",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 253.97,
   "t1": 263.617
  },
  {
   "text": "Charles Nicolle, Tunis",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 264.067,
   "t1": 270.854
  },
  {
   "text": "Bath and clean clothes",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 271.304,
   "t1": 278.09
  },
  {
   "text": "Wash the clothes, stop the fever",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 278.54,
   "t1": 283.145
  },
  {
   "text": "1909: the louse",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 283.595,
   "t1": 288.201
  },
  {
   "text": "Ricketts and Prowazek",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 288.651,
   "t1": 297.709
  },
  {
   "text": "Russia, 1919: 25 million cases",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 304.003,
   "t1": 309.831
  },
  {
   "text": "Either socialism defeats the louse...",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 310.281,
   "t1": 316.109
  },
  {
   "text": "Serbia, 1915",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 316.559,
   "t1": 322.388
  },
  {
   "text": "Rudolf Weigl's lice feeders",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 322.838,
   "t1": 328.75
  },
  {
   "text": "A vaccine from lice",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 329.2,
   "t1": 335.113
  },
  {
   "text": "Smuggled vaccine",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 335.563,
   "t1": 348.353
  },
  {
   "text": "Naples, 1943",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 348.803,
   "t1": 353.771
  },
  {
   "text": "Stopped in winter",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 354.221,
   "t1": 359.19
  },
  {
   "text": "DDT",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 359.64,
   "t1": 364.608
  },
  {
   "text": "A few days of antibiotics",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 365.058,
   "t1": 370.759
  },
  {
   "text": "What He Leaves Behind",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 379.225,
   "t1": 388.379
  },
  {
   "text": "He can come back",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 379.225,
   "t1": 388.379
  },
  {
   "text": "Delousing stations",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 388.829,
   "t1": 395.894
  },
  {
   "text": "He shaped wars and migrations",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 396.344,
   "t1": 403.409
  },
  {
   "text": "Still here",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 409.413,
   "t1": 416.158
  },
  {
   "text": "Refugee camps, prisons, highlands",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 416.608,
   "t1": 423.352
  },
