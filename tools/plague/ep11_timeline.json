   "style": "title",
   "color": [
    220,
    120,
    110
   ],
   "t0": 42.01,
   "t1": 45.91
  },
  {
   "text": "Rickettsia prowazekii",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 52.757,
   "t1": 58.654
  },
  {
   "text": "The itch does the rest",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 59.104,
   "t1": 63.389
  },
  {
   "text": "Scratch, scratch",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 63.839,
   "t1": 68.123
  },
  {
   "text": "Hiding in the seams",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 68.573,
   "t1": 72.858
  },
  {
   "text": "Soldiers, prisoners, refugees",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 73.308,
   "t1": 77.99
  },
  {
   "text": "No baths, no clean clothes",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 78.44,
   "t1": 83.123
  },
  {
   "text": "Clothes made a new home for lice",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 89.114,
   "t1": 97.032
  },
  {
   "text": "About 100,000 years ago",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 97.482,
   "t1": 105.399
  },
  {
   "text": "Typhus is not typhoid",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 105.849,
   "t1": 119.061
  },
  {
   "text": "What He Does to You",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 125.93,
   "t1": 129.519
  },
  {
   "text": "Fever, headache, aching muscles",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 125.93,
   "t1": 129.519
  },
  {
   "text": "A crushing headache",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 129.969,
   "t1": 133.557
  },
  {
   "text": "A rash that spreads outward",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 134.007,
   "t1": 137.641
  },
  {
   "text": "The rash",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 138.091,
   "t1": 141.725
  },
  {
   "text": "The haze",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 142.175,
   "t1": 147.489
  },
  {
   "text": "Up to 4 in 10 died",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 147.939,
   "t1": 153.254
  },
  {
   "text": "He can wake up decades later",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 153.704,
   "t1": 161.741
  },
  {
   "text": "Granada, 1489",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 168.791,
   "t1": 174.819
  },
  {
   "text": "17,000 to fever, 3,000 to swords",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 175.269,
   "t1": 181.298
  },
  {
   "text": "Camp fever, war fever, ship fever",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 181.748,
   "t1": 186.41
  },
  {
   "text": "Ship fever",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 186.86,
   "t1": 191.522
  },
  {
   "text": "Oxford, 1577: the Black Assize",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 191.972,
   "t1": 205.867
  },
  {
   "text": "Summer 1812",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 211.178,
   "t1": 223.17
  },
  {
   "text": "The lice moved with the coats",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 223.62,
   "t1": 227.268
  },
  {
   "text": "About 600,000 went in, few came back",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 227.718,
   "t1": 231.366
  },
  {
   "text": "Vilnius, December 1812",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 231.816,
   "t1": 235.465
  },
  {
   "text": "Ireland, 1847: the coffin ships",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 240.507,
   "t1": 253.259
  },
  {
   "text": "Grosse \u00cele, Canada",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 253.709,
   "t1": 263.356
  },
  {
   "text": "Charles Nicolle, Tunis",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 263.806,
   "t1": 270.593
  },
  {
   "text": "Bath and clean clothes",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 271.043,
   "t1": 277.829
  },
  {
   "text": "Wash the clothes, stop the fever",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 278.279,
   "t1": 282.885
  },
  {
   "text": "1909: the louse",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 283.335,
   "t1": 287.94
  },
  {
   "text": "Ricketts and Prowazek",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 288.39,
   "t1": 297.283
  },
  {
   "text": "Russia, 1919: 25 million cases",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 303.577,
   "t1": 309.405
  },
  {
   "text": "Either socialism defeats the louse...",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 309.855,
   "t1": 315.683
  },
  {
   "text": "Serbia, 1915",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 316.133,
   "t1": 321.962
  },
  {
   "text": "Rudolf Weigl's lice feeders",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 322.412,
   "t1": 328.324
  },
  {
   "text": "A vaccine from lice",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 328.774,
   "t1": 334.687
  },
  {
   "text": "Smuggled vaccine",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 335.137,
   "t1": 347.927
  },
  {
   "text": "Naples, 1943",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 348.377,
   "t1": 353.345
  },
  {
   "text": "Stopped in winter",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 353.795,
   "t1": 358.764
  },
  {
   "text": "DDT",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 359.214,
   "t1": 364.182
  },
  {
   "text": "A few days of antibiotics",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 364.632,
   "t1": 370.333
  },
  {
   "text": "What He Leaves Behind",
   "x": 960,
   "y": 150,
   "size": 72,
   "t0": 378.799,
   "t1": 387.954
  },
  {
   "text": "He can come back",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 378.799,
   "t1": 387.954
  },
  {
   "text": "Delousing stations",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 388.404,
   "t1": 395.468
  },
  {
   "text": "He shaped wars and migrations",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 395.918,
   "t1": 402.983
  },
  {
   "text": "Still here",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 408.987,
   "t1": 415.732
  },
  {
   "text": "Refugee camps, prisons, highlands",
   "x": 960,
   "y": 985,
   "size": 50,
   "t0": 416.182,
   "t1": 422.926
  },
  {
   "text": "NEXT TIME",
